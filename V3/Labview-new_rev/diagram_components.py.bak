"""
diagram_components.py

Visual components for the interactive refrigeration diagram.
"""
import logging
from PyQt6.QtWidgets import QGraphicsRectItem, QGraphicsTextItem, QGraphicsPathItem, QGraphicsItem, QGraphicsEllipseItem
from PyQt6.QtGui import QPen, QBrush, QColor, QPainterPath, QTransform, QPainter, QPainterPathStroker, QPolygonF
from PyQt6.QtCore import Qt, QRectF, QPointF

from component_schemas import SCHEMAS

logger = logging.getLogger(__name__)

# ---------------------------------------------------------------------------
#  Grid-snap helpers (toggled from the toolbar checkbox in diagram_widget.py)
# ---------------------------------------------------------------------------
GRID_SIZE = 20
_grid_snap_enabled = False

def snap_to_grid(pos):
    """Snap a QPointF to the nearest grid point if snapping is enabled."""
    if not _grid_snap_enabled:
        return pos
    snapped_x = round(pos.x() / GRID_SIZE) * GRID_SIZE
    snapped_y = round(pos.y() / GRID_SIZE) * GRID_SIZE
    return QPointF(snapped_x, snapped_y)

def _snap_port_pos(val):
    """Snap a single coordinate to the nearest grid multiple (always active).
    Ensures port positions land on the 20px grid for clean pipe routing.
    Uses floor(x + 0.5) instead of round() to avoid banker's rounding
    where round(0.5)=0 and round(1.5)=2 cause port collisions."""
    import math
    return math.floor(val / GRID_SIZE + 0.5) * GRID_SIZE


class BaseComponentItem(QGraphicsRectItem):
    """A draggable, rotatable component with ports."""
    
    def __init__(self, component_id, component_data, data_manager):
        # Get size from component_data
        size = component_data.get('size', {'width': 100, 'height': 60})
        super().__init__(0, 0, size['width'], size['height'])
        
        self.component_id = component_id
        self.component_data = component_data
        self.data_manager = data_manager
        self.schema = SCHEMAS.get(component_data['type'], {})
        
        # Initialize ports first
        self.ports = {}
        # Default: components placed directly on the diagram (not in a sensor box)
        self.sensor_box = None
        
        # High contrast colors for dark theme support
        self.setBrush(QBrush(QColor("#1E1E1E")))  # Dark fill
        self.setPen(QPen(QColor("#4DA6FF"), 2))  # Blueish outline
        
        # Create label
        circuit_label = component_data.get('properties', {}).get('circuit_label', 'None')
        if circuit_label and circuit_label != "None":
            label_text = f"[{circuit_label} {component_data['type']}]"
        else:
            label_text = f"[{component_data['type']}]"
        self.label = QGraphicsTextItem(label_text, self)
        self.label.setDefaultTextColor(QColor("#FFFFFF"))  # White text
        # Center the label later or put it at top-left
        self.label.setPos(5, 5)
        
        # IMPROVED: Smoother interaction flags
        simple = component_data.get('_simple_mode', False)
        self.setFlag(QGraphicsItem.GraphicsItemFlag.ItemIsMovable, not simple)
        self.setFlag(QGraphicsItem.GraphicsItemFlag.ItemIsSelectable, not simple)
        self.setFlag(QGraphicsItem.GraphicsItemFlag.ItemSendsGeometryChanges, True)
        self.setCacheMode(QGraphicsItem.CacheMode.DeviceCoordinateCache)  # Better performance

        # Set position from data
        pos = component_data.get('position', [0, 0])
        if isinstance(pos, QPointF):
            self.setPos(pos)
        else:
            self.setPos(pos[0], pos[1])

        # Set rotation from data
        rotation = component_data.get('rotation', 0)
        self.setRotation(rotation)

        # Build ports
        self.rebuild_ports()

        # Simple-mode: make Junction boxes invisible (pipes connect through hidden ports)
        if simple and component_data.get('type') == 'Junction':
            self.setPen(QPen(Qt.GlobalColor.transparent))
            self.setBrush(QBrush(Qt.GlobalColor.transparent))
            if hasattr(self, 'label'):
                self.label.hide()
            for port in self.ports.values():
                port.hide()
    
    def _legacy_paint(self, painter, option, widget=None):
        """Standard paint with no custom shapes."""
        painter.setRenderHint(QPainter.RenderHint.Antialiasing, True)
        painter.setRenderHint(QPainter.RenderHint.TextAntialiasing, True)
        super().paint(painter, option, widget)

        # === EVAPORATOR DISTRIBUTOR VISUAL LINES + AIRFLOW ARROWS ===
        if comp_type == 'Evaporator':
            props = self.component_data.get('properties', {})
            inlet_dist = (props.get('inlet_distributor') or 'No')
            outlet_dist = (props.get('outlet_distributor') or 'No')
            airflow = props.get('air_flow_direction') or 'Bottom to Top'

            circuits = props.get('circuits', 1)
            port_spacing = props.get('port_spacing', 20)
            w = self.rect().width()
            h = self.rect().height()
            total_ph = (circuits - 1) * port_spacing if circuits > 1 else 0

            # --- Fin hatching down the centre: reads as a finned coil ---
            fin_pen = QPen(QColor("#90A4AE"), 1.5)
            painter.setPen(fin_pen)
            fin_x0, fin_x1 = w * 0.34, w * 0.66
            fin_top, fin_bot = h * 0.14, h * 0.92
            n_fins = 9
            for i in range(n_fins):
                fx = fin_x0 + (fin_x1 - fin_x0) * i / (n_fins - 1)
                painter.drawLine(QPointF(fx, fin_top), QPointF(fx, fin_bot))

            # --- Distributor trunk/branch lines (existing behavior) ---
            if inlet_dist == 'Yes' or outlet_dist == 'Yes':
                dist_pen = QPen(QColor("#000000"), 3)
                dist_pen.setCapStyle(Qt.PenCapStyle.RoundCap)
                painter.setPen(dist_pen)
                painter.setBrush(QBrush(Qt.GlobalColor.transparent))

                if inlet_dist == 'Yes':
                    de = getattr(self, '_dist_inlet_extension', 120)
                    vert_x = -80  # x-position of vertical trunk line
                    trunk_y = _snap_port_pos(h / 2)

                    # Compute first/last circuit y positions (snapped to grid)
                    y_first = _snap_port_pos(h / 2 + (0 * port_spacing - total_ph / 2))
                    y_last = _snap_port_pos(h / 2 + ((circuits - 1) * port_spacing - total_ph / 2))

                    # Part 1: Horizontal trunk from dist_inlet port to vertical trunk
                    painter.drawLine(QPointF(-de, trunk_y), QPointF(vert_x, trunk_y))

                    # Part 2: Vertical line from top circuit to bottom circuit
                    painter.drawLine(QPointF(vert_x, y_first), QPointF(vert_x, y_last))

                    # Part 3: Horizontal stub from vertical trunk to body edge at each circuit
                    for i in range(1, circuits + 1):
                        y_c = _snap_port_pos(h / 2 + ((i - 1) * port_spacing - total_ph / 2))
                        painter.drawLine(QPointF(vert_x, y_c), QPointF(0, y_c))

                if outlet_dist == 'Yes':
                    de = getattr(self, '_dist_outlet_extension', 120)
                    vert_x = w + 80  # x-position of vertical trunk line
                    trunk_y = _snap_port_pos(h / 2)

                    # Compute first/last circuit y positions (snapped to grid)
                    y_first = _snap_port_pos(h / 2 + (0 * port_spacing - total_ph / 2))
                    y_last = _snap_port_pos(h / 2 + ((circuits - 1) * port_spacing - total_ph / 2))

                    # Part 1: Horizontal stub from body edge to vertical trunk at each circuit
                    for i in range(1, circuits + 1):
                        y_c = _snap_port_pos(h / 2 + ((i - 1) * port_spacing - total_ph / 2))
                        painter.drawLine(QPointF(w, y_c), QPointF(vert_x, y_c))

                    # Part 2: Vertical line from top circuit to bottom circuit
                    painter.drawLine(QPointF(vert_x, y_first), QPointF(vert_x, y_last))

                    # Part 3: Horizontal trunk from vertical trunk to dist_outlet port
                    painter.drawLine(QPointF(vert_x, trunk_y), QPointF(w + de, trunk_y))

            # --- Airflow arrows: three at bottom and three at top, direction-aware ---
            arrow_pen = QPen(QColor("#2c3e50"), 3)
            arrow_pen.setCapStyle(Qt.PenCapStyle.RoundCap)
            painter.setPen(arrow_pen)
            painter.setBrush(QBrush(QColor("#2c3e50")))

            arrow_len = 30

            # Use one arrow per fan sensor, aligned with ports
            fan_count = props.get('fan_sensor_count', 0)
            if fan_count < 1:
                fan_count = 1

            def draw_arrow_up_from_bottom(x: float):
                """Arrow from below pointing up into the coil bottom edge."""
                start = QPointF(x, h + arrow_len)
                tip = QPointF(x, h)
                painter.drawLine(start, tip)
                head = QPolygonF([
                    QPointF(x - 6, h + 10),
                    QPointF(x + 6, h + 10),
                    QPointF(x, h),
                ])
                painter.drawPolygon(head)

            def draw_arrow_down_from_top(x: float):
                """Arrow from above pointing down into the coil top edge."""
                start = QPointF(x, -arrow_len)
                tip = QPointF(x, 0)
                painter.drawLine(start, tip)
                head = QPolygonF([
                    QPointF(x - 6, -10),
                    QPointF(x + 6, -10),
                    QPointF(x, 0),
                ])
                painter.drawPolygon(head)

            def draw_arrow_out_bottom(x: float):
                """Arrow starting at coil bottom edge and pointing down away."""
                start = QPointF(x, h)
                tip = QPointF(x, h + arrow_len)
                painter.drawLine(start, tip)
                head = QPolygonF([
                    QPointF(x - 6, h + arrow_len - 10),
                    QPointF(x + 6, h + arrow_len - 10),
                    QPointF(x, h + arrow_len),
                ])
                painter.drawPolygon(head)

            def draw_arrow_out_top(x: float):
                """Arrow starting at coil top edge and pointing up away."""
                start = QPointF(x, 0)
                tip = QPointF(x, -arrow_len)
                painter.drawLine(start, tip)
                head = QPolygonF([
                    QPointF(x - 6, -arrow_len + 10),
                    QPointF(x + 6, -arrow_len + 10),
                    QPointF(x, -arrow_len),
                ])
                painter.drawPolygon(head)

            for i in range(1, fan_count + 1):
                # Mirror the sensor placement logic: evenly distributed across width
                x = _snap_port_pos((i * w) / (fan_count + 1))

                if airflow == 'Bottom to Top':
                    # Bottom = air in, Top = air out
                    draw_arrow_up_from_bottom(x)
                    draw_arrow_out_top(x)
                else:
                    # Top = air in, Bottom = air out
                    draw_arrow_down_from_top(x)
                    draw_arrow_out_bottom(x)

        # === CONDENSER VISUALS: A-cool / W-cool (inside), arrows outside ===
        if comp_type == 'Condenser':
            props = self.component_data.get('properties', {})
            condenser_type = props.get('condenser_type', 'Air Cooled')
            w = self.rect().width()
            h = self.rect().height()

            # Draw A-cool / W-cool label INSIDE the condenser (top center, below existing label)
            label_text = "A-cool" if condenser_type == 'Air Cooled' else "W-cool"
            painter.setPen(QPen(QColor("#2c3e50")))
            painter.setBrush(Qt.GlobalColor.transparent)
            painter.drawText(QRectF(0, 22, w, 22), Qt.AlignmentFlag.AlignCenter, label_text)

            # Serpentine coil — marks this as a heat exchanger (condensing coil)
            _draw_serpentine(painter, 14, w - 14, h * 0.62, h * 0.16, 5, QColor("#37474F"))

            arrow_pen = QPen(QColor("#2c3e50"), 3)
            arrow_pen.setCapStyle(Qt.PenCapStyle.RoundCap)
            painter.setPen(arrow_pen)
            painter.setBrush(QBrush(QColor("#2c3e50")))

            arrow_len = 25
            arrow_count = 3  # fixed number of arrows

            if condenser_type == 'Air Cooled':
                # Air-cooled: 3 airflow arrows bottom-to-top (fixed)
                def draw_arrow_up_bottom(x: float):
                    start = QPointF(x, h + arrow_len)
                    tip = QPointF(x, h)
                    painter.drawLine(start, tip)
                    head = QPolygonF([
                        QPointF(x - 5, h + 8),
                        QPointF(x + 5, h + 8),
                        QPointF(x, h),
                    ])
                    painter.drawPolygon(head)

                def draw_arrow_out_top(x: float):
                    start = QPointF(x, 0)
                    tip = QPointF(x, -arrow_len)
                    painter.drawLine(start, tip)
                    head = QPolygonF([
                        QPointF(x - 5, -arrow_len + 8),
                        QPointF(x + 5, -arrow_len + 8),
                        QPointF(x, -arrow_len),
                    ])
                    painter.drawPolygon(head)

                for i in range(1, arrow_count + 1):
                    x = _snap_port_pos((i * w) / (arrow_count + 1))
                    draw_arrow_up_bottom(x)
                    draw_arrow_out_top(x)

            else:
                # Water-cooled: vertical arrows — water in (bottom, pointing up into), water out (top, pointing up away)
                center_x = _snap_port_pos(w / 2)
                arrow_len = 30

                # Water in: arrow from below, pointing UP into condenser
                painter.drawLine(QPointF(center_x, h + arrow_len), QPointF(center_x, h))
                head_in = QPolygonF([
                    QPointF(center_x - 5, h + 8),
                    QPointF(center_x + 5, h + 8),
                    QPointF(center_x, h),
                ])
                painter.drawPolygon(head_in)

                # Water out: arrow from top of condenser, pointing UP away
                painter.drawLine(QPointF(center_x, 0), QPointF(center_x, -arrow_len))
                head_out = QPolygonF([
                    QPointF(center_x - 5, -arrow_len + 8),
                    QPointF(center_x + 5, -arrow_len + 8),
                    QPointF(center_x, -arrow_len),
                ])
                painter.drawPolygon(head_out)

        # Keep label upright regardless of component rotation
        rotation = self.rotation()
        self.label.setRotation(-rotation)

    def boundingRect(self):
        """Extended bounding rect to include distributor and airflow visuals."""
        rect = super().boundingRect()
        comp_type = self.component_data.get('type')
        if comp_type == 'Evaporator':
            left_ext = getattr(self, '_dist_inlet_extension', 0)
            right_ext = getattr(self, '_dist_outlet_extension', 0)
            arrow_ext = 40  # room for top/bottom airflow arrows
            rect = rect.adjusted(-left_ext - 10, -arrow_ext, right_ext + 10, arrow_ext)
        elif comp_type == 'Condenser':
            # Extra room for label, airflow arrows (top/bottom), and water arrows (left/right)
            arrow_ext = 40
            rect = rect.adjusted(-arrow_ext, -arrow_ext, arrow_ext, arrow_ext)
        return rect

    def rebuild_ports(self):
        """Create ports: 1 inlet and multiple outlets based on circuit_count."""
        # IMPORTANT: Save pipe connections before clearing ports
        port_connections = {}
        for port_name, port_item in self.ports.items():
            if hasattr(port_item, 'connected_pipes') and port_item.connected_pipes:
                port_connections[port_name] = list(port_item.connected_pipes)
        
        # Clear existing ports
        for port_item in list(self.ports.values()):
            port_item.setParentItem(None)
            if port_item.scene():
                port_item.scene().removeItem(port_item)
        self.ports.clear()
        
        # Get circuit count and port spacing
        circuit_count = self.component_data.get('properties', {}).get('circuit_count', 1)
        port_spacing = self.component_data.get('properties', {}).get('port_spacing', 20)
        snapped_mode = self.component_data.get('properties', {}).get('snapped_mode') == 'Yes'
        width = self.component_data.get('properties', {}).get('width', 240)
        
        if snapped_mode:
            # Inlet on top
            inlet_def = {'name': 'inlet', 'type': 'in', 'fluid_state': 'two-phase', 'pressure_side': 'low', 'position': [0.5, 0]}
            inlet_port = PortItem('inlet', inlet_def, self)
            inlet_port.setPos(width/2, -15)
            self.ports['inlet'] = inlet_port
            
            # Outlets on bottom
            outlet_width = max(width, circuit_count * 30)
            start_x = (width - outlet_width) / 2
            spacing = outlet_width / max(1, circuit_count - 1)
            for i in range(circuit_count):
                port_name = f"outlet_{i+1}"
                outlet_def = {'name': port_name, 'type': 'out', 'fluid_state': 'two-phase', 'pressure_side': 'low', 'position': [0.5, 1]}
                outlet_port = PortItem(port_name, outlet_def, self)
                px = _snap_port_pos(start_x + i * spacing) if circuit_count > 1 else _snap_port_pos(width / 2)
                outlet_port.setPos(px, 15)
                self.ports[port_name] = outlet_port
        else:
            # Single inlet on the left (low pressure)
            inlet_def = {'name': 'inlet', 'type': 'in', 'fluid_state': 'two-phase', 'pressure_side': 'low', 'position': [0, 0.5]}
            inlet_port = PortItem('inlet', inlet_def, self)
            inlet_port.setPos(_snap_port_pos(-30), 0)
            self.ports['inlet'] = inlet_port
    
            # Multiple outlets on the right (low pressure)
            outlet_height = (circuit_count - 1) * port_spacing
            for i in range(circuit_count):
                port_name = f"outlet_{i+1}"
                outlet_def = {'name': port_name, 'type': 'out', 'fluid_state': 'two-phase', 'pressure_side': 'low', 'position': [1, 0.5]}
                outlet_port = PortItem(port_name, outlet_def, self)
                y_pos = _snap_port_pos(i * port_spacing - outlet_height / 2)
                outlet_port.setPos(_snap_port_pos(30), y_pos)
                self.ports[port_name] = outlet_port
        
        # IMPORTANT: Restore pipe connections to ports with matching names
        total_restored = 0
        comp_type = self.component_data['type']
        for port_name, pipes in port_connections.items():
            if port_name in self.ports:
                new_port = self.ports[port_name]
                for pipe in pipes:
                    # Add connection to new port
                    if hasattr(new_port, 'add_connected_pipe'):
                        new_port.add_connected_pipe(pipe)
                    # Update pipe's internal port references
                    if hasattr(pipe, 'start_port_item') and hasattr(pipe, 'end_port_item'):
                        if hasattr(pipe, 'pipe_data') and hasattr(pipe, 'pipe_id'):
                            pipe_data = pipe.pipe_data
                            start_comp_id = pipe_data.get('start_component_id')
                            start_port = pipe_data.get('start_port')
                            end_comp_id = pipe_data.get('end_component_id')
                            end_port = pipe_data.get('end_port')
                            
                            if start_comp_id == self.component_id and start_port == port_name:
                                pipe.start_port_item = new_port
                            if end_comp_id == self.component_id and end_port == port_name:
                                pipe.end_port_item = new_port
                    if hasattr(pipe, 'update_path'):
                        pipe.update_path()
                    total_restored += 1
        
        if total_restored > 0:
            print(f"[REBUILD] Restored {total_restored} pipe connections to {comp_type}")
        
        # Update the visual shape after ports are rebuilt
        self.update_shape()
        # Update any connected pipes
        self.update_connected_pipes()

    def update_shape(self):
        """Draw double lines to distinguish from junction."""
        circuit_count = self.component_data.get('properties', {}).get('circuit_count', 1)
        port_spacing = self.component_data.get('properties', {}).get('port_spacing', 20)
        snapped_mode = self.component_data.get('properties', {}).get('snapped_mode') == 'Yes'
        width = self.component_data.get('properties', {}).get('width', 240)

        path = QPainterPath()

        if snapped_mode:
            manifold_y_split = 0
            path.moveTo(width / 2, -15) # Top inlet
            path.lineTo(width / 2, manifold_y_split)
            
            outlet_width = max(width, circuit_count * 30)
            start_x = (width - outlet_width) / 2
            
            path.moveTo(start_x, manifold_y_split)
            path.lineTo(start_x + outlet_width, manifold_y_split)
            
            spacing = outlet_width / max(1, circuit_count - 1)
            for i in range(circuit_count):
                px = _snap_port_pos(start_x + i * spacing) if circuit_count > 1 else _snap_port_pos(width / 2)
                path.moveTo(px, manifold_y_split)
                path.lineTo(px, manifold_y_split + 15)
        else:
            inlet_x = _snap_port_pos(-30)    # -20
            outlet_x = _snap_port_pos(30)    # 40
    
            # Double horizontal main lines (parallel lines with 4 pixel spacing)
            path.moveTo(inlet_x, -2)
            path.lineTo(outlet_x, -2)
            path.moveTo(inlet_x, 2)
            path.lineTo(outlet_x, 2)
    
            # Inlet double vertical line
            path.moveTo(inlet_x - 2, -2)
            path.lineTo(inlet_x - 2, 0)
            path.moveTo(inlet_x + 2, -2)
            path.lineTo(inlet_x + 2, 0)
    
            # Outlet double vertical lines
            outlet_height = (circuit_count - 1) * port_spacing
            for i in range(circuit_count):
                y_pos = _snap_port_pos(i * port_spacing - outlet_height / 2)
                path.moveTo(outlet_x - 2, 0)
                path.lineTo(outlet_x - 2, y_pos)
                path.moveTo(outlet_x + 2, 0)
                path.lineTo(outlet_x + 2, y_pos)

        self.setPath(path)

    def boundingRect(self):
        """Extended bounding rect to include distributor and airflow visuals."""
        rect = super().boundingRect()
        comp_type = self.component_data.get('type')
        if comp_type == 'Evaporator':
            left_ext = getattr(self, '_dist_inlet_extension', 0)
            right_ext = getattr(self, '_dist_outlet_extension', 0)
            arrow_ext = 40  # room for top/bottom airflow arrows
            rect = rect.adjusted(-left_ext - 10, -arrow_ext, right_ext + 10, arrow_ext)
        elif comp_type == 'Condenser':
            # Extra room for label, airflow arrows (top/bottom), and water arrows (left/right)
            arrow_ext = 40
            rect = rect.adjusted(-arrow_ext, -arrow_ext, arrow_ext, arrow_ext)
        return rect

    def rebuild_ports(self):
        """Rebuild all ports based on schema and current properties."""
        # IMPORTANT: Save pipe connections before clearing ports
        port_connections = {}
        for port_name, port_item in self.ports.items():
            if hasattr(port_item, 'connected_pipes') and port_item.connected_pipes:
                port_connections[port_name] = list(port_item.connected_pipes)
        
        # Clear existing ports
        for port_item in list(self.ports.values()):
            if port_item.scene():
                self.scene().removeItem(port_item)
        self.ports.clear()
        
        comp_type = self.component_data['type']
        schema = SCHEMAS.get(comp_type, {})
        
        # Get component size
        width = self.rect().width()
        height = self.rect().height()
        
        _simple = self.component_data.get('_simple_mode', False)

        # Add fixed ports
        for port_def in schema.get('ports', []):
            if _simple and port_def.get('type') == 'sensor':
                continue
            port_name = port_def['name']
            port_pos = port_def['position']
            x = _snap_port_pos(port_pos[0] * width)
            y = _snap_port_pos(port_pos[1] * height)

            port_item = PortItem(port_name, port_def, self)
            port_item.setPos(x, y)
            self.ports[port_name] = port_item
            if self.scene():
                self.scene().addItem(port_item)
        
        # Add dynamic ports (inlet side)
        dynamic_config = schema.get('dynamic_ports')
        if dynamic_config:
            prefix = dynamic_config['prefix']
            count_prop = dynamic_config['count_property']
            port_details = dynamic_config['port_details']
            side = dynamic_config['position_side']
            
            count = self.component_data.get('properties', {}).get(count_prop, 1)
            port_spacing = self.component_data.get('properties', {}).get('port_spacing', 20)
            print(f"[REBUILD] Ports for {comp_type} - {count_prop}={count}, port_spacing={port_spacing}")
            
            # Calculate total height needed for ports
            total_port_height = (count - 1) * port_spacing if count > 1 else 0
            
            snapped_mode = self.component_data.get('properties', {}).get('snapped_mode') == 'Yes'
            if snapped_mode:
                if side == "left": side = "top"
                elif side == "right": side = "bottom"
                
            for i in range(1, count + 1):
                port_name = f"{prefix}{i}"
                
                # Calculate position based on side with port_spacing
                if side == "left":
                    x = 0
                    y = _snap_port_pos(height / 2 + ((i - 1) * port_spacing - total_port_height / 2))
                elif side == "right":
                    x = width
                    y = _snap_port_pos(height / 2 + ((i - 1) * port_spacing - total_port_height / 2))
                elif side == "top":
                    x = _snap_port_pos(width / 2 + ((i - 1) * port_spacing - total_port_height / 2))
                    y = 0
                else:  # bottom
                    x = _snap_port_pos(width / 2 + ((i - 1) * port_spacing - total_port_height / 2))
                    y = height

                port_def = {
                    "name": port_name,
                    "type": port_details['type'],
                    "fluid_state": port_details['fluid_state'],
                    "position": [x / width, y / height]
                }

                port_item = PortItem(port_name, port_def, self)
                port_item.setPos(x, y)
                self.ports[port_name] = port_item
                if self.scene():
                    self.scene().addItem(port_item)

        # Add dynamic ports 2 (outlet side)
        dynamic_config_2 = schema.get('dynamic_ports_2')
        if dynamic_config_2:
            prefix = dynamic_config_2['prefix']
            count_prop = dynamic_config_2['count_property']
            port_details = dynamic_config_2['port_details']
            side = dynamic_config_2['position_side']

            count = self.component_data.get('properties', {}).get(count_prop, 1)
            port_spacing = self.component_data.get('properties', {}).get('port_spacing', 20)

            # Calculate total height needed for ports
            total_port_height = (count - 1) * port_spacing if count > 1 else 0

            snapped_mode = self.component_data.get('properties', {}).get('snapped_mode') == 'Yes'
            if snapped_mode:
                if side == "left": side = "top"
                elif side == "right": side = "bottom"

            for i in range(1, count + 1):
                port_name = f"{prefix}{i}"

                # Calculate position based on side with port_spacing
                if side == "left":
                    x = 0
                    y = _snap_port_pos(height / 2 + ((i - 1) * port_spacing - total_port_height / 2))
                elif side == "right":
                    x = width
                    y = _snap_port_pos(height / 2 + ((i - 1) * port_spacing - total_port_height / 2))
                elif side == "top":
                    x = _snap_port_pos(width / 2 + ((i - 1) * port_spacing - total_port_height / 2))
                    y = 0
                else:  # bottom
                    x = _snap_port_pos(width / 2 + ((i - 1) * port_spacing - total_port_height / 2))
                    y = height

                port_def = {
                    "name": port_name,
                    "type": port_details['type'],
                    "fluid_state": port_details['fluid_state'],
                    "position": [x / width, y / height]
                }

                port_item = PortItem(port_name, port_def, self)
                port_item.setPos(x, y)
                self.ports[port_name] = port_item
                if self.scene():
                    self.scene().addItem(port_item)

        # Add dynamic ports 3 (e.g., evaporator fan sensors) — skip in simple mode
        dynamic_config_3 = schema.get('dynamic_ports_3')
        if dynamic_config_3 and not _simple:
            prefix = dynamic_config_3['prefix']
            count_prop = dynamic_config_3['count_property']
            port_details = dynamic_config_3['port_details']
            side = dynamic_config_3['position_side']

            count = self.component_data.get('properties', {}).get(count_prop, 1)
            if count < 1:
                count = 1

            for i in range(1, count + 1):
                # Evenly space sensors across the evaporator width, aligned with arrows
                x = _snap_port_pos((i * width) / (count + 1))

                # Bottom sensor (air side at bottom of coil)
                port_name_bottom = f"{prefix}{i}"
                y_bottom = height
                port_def_bottom = {
                    "name": port_name_bottom,
                    "type": port_details['type'],
                    "fluid_state": port_details['fluid_state'],
                    "position": [x / width, y_bottom / height]
                }
                bottom_item = PortItem(port_name_bottom, port_def_bottom, self)
                bottom_item.setPos(x, y_bottom)
                self.ports[port_name_bottom] = bottom_item
                if self.scene():
                    self.scene().addItem(bottom_item)

                # Matching top sensor (air side at top of coil)
                port_name_top = f"sensor_top_{i}"
                y_top = 0
                port_def_top = {
                    "name": port_name_top,
                    "type": port_details['type'],
                    "fluid_state": port_details['fluid_state'],
                    "position": [x / width, y_top / height]
                }
                top_item = PortItem(port_name_top, port_def_top, self)
                top_item.setPos(x, y_top)
                self.ports[port_name_top] = top_item
                if self.scene():
                    self.scene().addItem(top_item)
        
        # === EVAPORATOR DISTRIBUTOR PORT ADJUSTMENT ===
        # When distributor is enabled, individual circuit ports become sensor-only
        # (green dots on body edge) and a single dist_inlet/dist_outlet port is created.
        if comp_type == 'Evaporator':
            props = self.component_data.get('properties', {})
            inlet_dist = props.get('inlet_distributor') or 'No'
            outlet_dist = props.get('outlet_distributor') or 'No'
            circuits = props.get('circuits', 1)
            port_spacing = props.get('port_spacing', 20)

            # Initialize distributor extension widths (used by paint/boundingRect)
            self._dist_inlet_extension = 0
            self._dist_outlet_extension = 0

            if inlet_dist == 'Yes':
                dist_extension = 120
                self._dist_inlet_extension = dist_extension

                # Reposition inlet_circuit_X ports to body left edge as sensor dots
                total_port_height = (circuits - 1) * port_spacing if circuits > 1 else 0
                for i in range(1, circuits + 1):
                    pname = f"inlet_circuit_{i}"
                    if pname in self.ports:
                        y = _snap_port_pos(height / 2 + ((i - 1) * port_spacing - total_port_height / 2))
                        self.ports[pname].setPos(0, y)
                        self.ports[pname].port_def['_original_type'] = self.ports[pname].port_def.get('type', 'in')
                        self.ports[pname].port_def['type'] = 'sensor'
                        self.ports[pname].setBrush(QBrush(QColor("#4CAF50")))

                # Create single distributor inlet port on far left
                dist_inlet_def = {
                    "name": "dist_inlet",
                    "type": "in",
                    "fluid_state": "two-phase",
                    "pressure_side": "low",
                    "position": [0, 0.5]
                }
                dist_inlet_port = PortItem("dist_inlet", dist_inlet_def, self)
                dist_inlet_port.setPos(-dist_extension, _snap_port_pos(height / 2))
                self.ports["dist_inlet"] = dist_inlet_port
                if self.scene():
                    self.scene().addItem(dist_inlet_port)
                print(f"[REBUILD] Evaporator inlet distributor ON: 1 dist_inlet port, {circuits} sensor dots")

            if outlet_dist == 'Yes':
                dist_extension = 120
                self._dist_outlet_extension = dist_extension

                # Reposition outlet_circuit_X ports to body right edge as sensor dots
                total_port_height = (circuits - 1) * port_spacing if circuits > 1 else 0
                for i in range(1, circuits + 1):
                    pname = f"outlet_circuit_{i}"
                    if pname in self.ports:
                        y = _snap_port_pos(height / 2 + ((i - 1) * port_spacing - total_port_height / 2))
                        self.ports[pname].setPos(width, y)
                        self.ports[pname].port_def['_original_type'] = self.ports[pname].port_def.get('type', 'out')
                        self.ports[pname].port_def['type'] = 'sensor'
                        self.ports[pname].setBrush(QBrush(QColor("#4CAF50")))

                # Create single distributor outlet port on far right
                dist_outlet_def = {
                    "name": "dist_outlet",
                    "type": "out",
                    "fluid_state": "gas",
                    "pressure_side": "low",
                    "position": [1, 0.5]
                }
                dist_outlet_port = PortItem("dist_outlet", dist_outlet_def, self)
                dist_outlet_port.setPos(width + dist_extension, _snap_port_pos(height / 2))
                self.ports["dist_outlet"] = dist_outlet_port
                if self.scene():
                    self.scene().addItem(dist_outlet_port)
                print(f"[REBUILD] Evaporator outlet distributor ON: 1 dist_outlet port, {circuits} sensor dots")

        # Add conditional ports (based on property value) — skip in simple mode
        conditional_ports = schema.get('conditional_ports')
        if conditional_ports and not _simple:
            # Get the property that determines which ports to show
            # For Condenser, it's 'condenser_type'
            if comp_type == 'Condenser':
                condenser_type = self.component_data.get('properties', {}).get('condenser_type', 'Air Cooled')
                ports_to_add = conditional_ports.get(condenser_type, [])
            else:
                ports_to_add = []

            for port_def in ports_to_add:
                port_name = port_def['name']
                port_pos = port_def['position']
                x = port_pos[0] * width
                y = port_pos[1] * height

                port_item = PortItem(port_name, port_def, self)
                port_item.setPos(x, y)
                self.ports[port_name] = port_item
                if self.scene():
                    self.scene().addItem(port_item)

        # Condenser: when flip=Yes, swap inlet and outlet port positions (and port_def so pipe routing uses correct exit direction)
        if comp_type == 'Condenser':
            flip = self.component_data.get('properties', {}).get('flip', 'No') == 'Yes'
            if flip and 'inlet' in self.ports and 'outlet' in self.ports:
                self.ports['inlet'].setPos(width, _snap_port_pos(height / 2))
                self.ports['outlet'].setPos(0, _snap_port_pos(height / 2))
                # Update port_def position so PipeItem._get_port_exit_vector routes pipes from the correct side
                self.ports['inlet'].port_def['position'] = [1, 0.5]   # now on right edge
                self.ports['outlet'].port_def['position'] = [0, 0.5]  # now on left edge

        # IMPORTANT: Restore pipe connections to ports with matching names
        total_restored = 0
        for port_name, pipes in port_connections.items():
            if port_name in self.ports:
                new_port = self.ports[port_name]
                for pipe in pipes:
                    # Add connection to new port
                    if hasattr(new_port, 'add_connected_pipe'):
                        new_port.add_connected_pipe(pipe)
                    # Update pipe's internal port references
                    # Need to check if this pipe's start or end port was this one
                    if hasattr(pipe, 'start_port_item') and hasattr(pipe, 'end_port_item'):
                        # Check if pipe was connected to this port (by checking component_id and port name in pipe_data)
                        if hasattr(pipe, 'pipe_data') and hasattr(pipe, 'pipe_id'):
                            pipe_data = pipe.pipe_data
                            # Check if this is the start port
                            start_comp_id = pipe_data.get('start_component_id')
                            start_port = pipe_data.get('start_port')
                            end_comp_id = pipe_data.get('end_component_id')
                            end_port = pipe_data.get('end_port')
                            
                            # Update start_port_item if it matches
                            if start_comp_id == self.component_id and start_port == port_name:
                                pipe.start_port_item = new_port
                            # Update end_port_item if it matches
                            if end_comp_id == self.component_id and end_port == port_name:
                                pipe.end_port_item = new_port
                    # Update pipe path to reflect new port position
                    if hasattr(pipe, 'update_path'):
                        pipe.update_path()
                    total_restored += 1
        
        if total_restored > 0:
            print(f"[REBUILD] Restored {total_restored} pipe connections to {comp_type}")
    
    def update_size(self, width, height):
        """Update component size and reposition ports."""
        self.setRect(0, 0, width, height)
        if 'size' not in self.component_data:
            self.component_data['size'] = {}
        self.component_data['size']['width'] = width
        self.component_data['size']['height'] = height
        
        self.rebuild_ports()
        self.update_connected_pipes()

    def itemChange(self, change, value):
        if change == QGraphicsItem.GraphicsItemChange.ItemPositionChange:
            return snap_to_grid(value)
        if change == QGraphicsItem.GraphicsItemChange.ItemPositionHasChanged:
            # Update position in model
            self.data_manager.update_component_position(self.component_id, value)
            self.update_connected_pipes()

        if change == QGraphicsItem.GraphicsItemChange.ItemRotationHasChanged:
            # Save rotation to model
            self.component_data['rotation'] = value
            self.update_connected_pipes()

        return super().itemChange(change, value)

    def update_connected_pipes(self):
        """Update all pipes connected to this component's ports."""
        for port_item in self.ports.values():
            for pipe_item in port_item.connected_pipes:
                pipe_item.update_path()
    
    def mouseDoubleClickEvent(self, event):
        """Handle double-click to open property dialog."""
        sensor_box = getattr(self, "sensor_box", None)
        if sensor_box is not None or not (self.flags() & QGraphicsItem.GraphicsItemFlag.ItemIsMovable):
            # Not draggable (sensor box interior or movement disabled)
            super().mousePressEvent(event)
            return

        if event.button() == Qt.MouseButton.LeftButton:
            # Notify the scene/view that this component was double-clicked
            # The DiagramWidget will handle opening the property dialog
            if hasattr(self.scene(), 'views') and self.scene().views():
                view = self.scene().views()[0]
                if hasattr(view.parent(), 'on_component_double_clicked'):
                    view.parent().on_component_double_clicked(self)
        super().mouseDoubleClickEvent(event)


class PortItem(QGraphicsEllipseItem):
    """A connection point on a component."""
    
    def __init__(self, port_name, port_def, parent_component):
        # IMPROVED: Slightly larger ports for better visibility
        super().__init__(-4, -4, 8, 8)
        self.port_name = port_name
        self.port_def = port_def
        self.parent_component = parent_component
        self.connected_pipes = []
        
        # Color-code by inlet/outlet type (consistent across all components)
        port_type = port_def.get('type', 'any')
        if port_type == 'in':
            color = QColor("#2196F3")  # Blue for all inlets
        elif port_type == 'out':
            color = QColor("#FF5722")  # Red for all outlets
        else:
            color = QColor("#4CAF50")  # Green for other/sensor ports
        
        self.setBrush(QBrush(color))
        # IMPROVED: Thicker white border for better visibility
        self.setPen(QPen(Qt.GlobalColor.white, 2))
        self.setParentItem(parent_component)
        
        self.setAcceptHoverEvents(True)
        self.setZValue(10)
        # IMPROVED: Better rendering
        self.setCacheMode(QGraphicsItem.CacheMode.DeviceCoordinateCache)
        
        # Set helpful tooltip
        self._update_tooltip()
    
    def _update_tooltip(self):
        """Generate and set a helpful tooltip for this port."""
        comp_type = self.parent_component.component_data.get('type', 'Unknown')
        port_type = self.port_def.get('type', 'any')
        port_name = self.port_name
        
        # Get a user-friendly description
        from port_resolver import format_port_label, resolve_mapped_sensor, get_sensor_value
        props = self.parent_component.component_data.get('properties', {})
        label = format_port_label(comp_type, props, port_name)
        
        # Resolve mapping and current value (if available)
        mapped_sensor = None
        current_value = None
        try:
            view_parent = self.parent_component.scene().views()[0].parent()
            dm = getattr(view_parent, 'data_manager', None)
            if dm is not None:
                diagram_model = dm.diagram_model
                comp_id = getattr(self.parent_component, 'component_id', '')
                mapped_sensor = resolve_mapped_sensor(diagram_model, comp_type, comp_id, port_name)
                if mapped_sensor:
                    current_value = get_sensor_value(dm, mapped_sensor)
        except Exception:
            mapped_sensor = None
            current_value = None
        
        # Build tooltip based on component type and port type
        if comp_type == 'Sensor':
            # Inline Sensor component — differentiate measurement port from inlet/outlet
            measure = props.get('measurement_type', 'Custom Measurement')
            sensor_label = props.get('label', '')
            if port_name == 'measurement':
                # Measurement port — this is the data point for calculations
                tooltip_lines = [
                    f"<b>{sensor_label or measure}</b>",
                    f"<i>{measure} — Measurement Port</i>",
                    "",
                    f"Map to: {measure} CSV column",
                    "This is the data point for calculations",
                    ""
                ]
                if mapped_sensor:
                    value_text = f"{current_value}" if current_value is not None else "(no data)"
                    tooltip_lines.append(f"<b>Mapped CSV:</b> {mapped_sensor}")
                    tooltip_lines.append(f"<b>Current Value:</b> {value_text}")
                else:
                    tooltip_lines.append("<span style='color:#c0392b'><b>Unmapped</b></span>")
                tooltip_lines.append("")
                tooltip_lines.append("<i>Click to map CSV column</i>")
            else:
                # Inlet/Outlet — pipe connection only
                tooltip_lines = [
                    f"<b>{sensor_label or measure}</b>",
                    f"<i>{measure} Sensor — {port_type.title()} Port</i>",
                    "",
                    "Pipe connection point (flow-through only)",
                    "",
                    "<i>Connect pipes here</i>"
                ]
        elif port_type == 'sensor':
            # Sensor ports - show what measurement they're for
            tooltip_lines = [
                f"<b>{label}</b>",
                f"<i>Sensor Port</i>",
                ""
            ]
            
            # Add specific guidance based on port name
            if port_name == 'SP':
                tooltip_lines.append("📍 <b>Map to:</b> Suction Pressure (PSIG)")
                tooltip_lines.append("🎯 <b>Used for:</b> Low-side pressure, ON-time filtering")
            elif port_name == 'DP':
                tooltip_lines.append("📍 <b>Map to:</b> Discharge/Liquid Pressure (PSIG)")
                tooltip_lines.append("🎯 <b>Used for:</b> High-side pressure")
            elif port_name == 'RPM':
                tooltip_lines.append("📍 <b>Map to:</b> Compressor RPM")
                tooltip_lines.append("🎯 <b>Used for:</b> Mass flow rate calculation")
            elif port_name == 'water_flow_gpm':
                tooltip_lines.append("📍 <b>Map to:</b> Water Flow (GPM)")
                tooltip_lines.append("🎯 <b>Used for:</b> Condenser water flow rate from CSV")
            elif 'bulb' in port_name.lower():
                tooltip_lines.append("📍 <b>Map to:</b> TXV Bulb Temperature (°F)")
                tooltip_lines.append("🎯 <b>Used for:</b> Reference (optional)")
            else:
                tooltip_lines.append("📍 <b>Map to:</b> Temperature or pressure sensor")
            
            tooltip_lines.append("")
            if mapped_sensor:
                value_text = f"{current_value}" if current_value is not None else "(no data in filter)"
                tooltip_lines.append(f"<b>Mapped CSV:</b> {mapped_sensor}")
                tooltip_lines.append(f"<b>Current Value:</b> {value_text}")
            else:
                tooltip_lines.append("<span style='color:#c0392b'><b>Unmapped</b></span>")
            tooltip_lines.append("")
            tooltip_lines.append("<i>Click to map CSV column to this port</i>")
            
        elif port_type == 'in':
            # Inlet ports - can be used for temperature sensors
            tooltip_lines = [
                f"<b>{label}</b>",
                f"<i>Inlet Port</i>",
                ""
            ]
            
            if comp_type == 'Compressor' and port_name == 'inlet':
                tooltip_lines.append("📍 <b>Map to:</b> Suction Line Temperature (°F)")
                tooltip_lines.append("🎯 <b>Used for:</b> State 2b (Compressor Inlet)")
                tooltip_lines.append("📊 <b>Calculation:</b> Superheat, Mass flow density")
            elif comp_type == 'TXV' and port_name == 'inlet':
                tooltip_lines.append("📍 <b>Map to:</b> TXV Inlet Temperature (°F)")
                tooltip_lines.append("🎯 <b>Used for:</b> State 4b (TXV Inlet)")
                tooltip_lines.append("📊 <b>Calculation:</b> Subcooling")
            elif comp_type == 'Condenser' and port_name == 'inlet':
                tooltip_lines.append("📍 <b>Map to:</b> Condenser Inlet Temperature (°F)")
                tooltip_lines.append("🎯 <b>Used for:</b> State 3b (Condenser Inlet)")
                tooltip_lines.append("📊 <b>Calculation:</b> Superheat (optional)")
            else:
                tooltip_lines.append("🔵 <b>Inlet connection point</b>")
                tooltip_lines.append("💡 Can also map temperature sensor here")
            
            tooltip_lines.append("")
            tooltip_lines.append("💡 <i>Click to map CSV column or connect pipe</i>")
            
        elif port_type == 'out':
            # Outlet ports - can be used for temperature sensors
            tooltip_lines = [
                f"<b>{label}</b>",
                f"<i>Outlet Port</i>",
                ""
            ]
            
            if comp_type == 'Compressor' and port_name == 'outlet':
                tooltip_lines.append("📍 <b>Map to:</b> Discharge Line Temperature (°F)")
                tooltip_lines.append("🎯 <b>Used for:</b> State 3a (Compressor Outlet)")
                tooltip_lines.append("📊 <b>Calculation:</b> Superheat, Heat rejection")
            elif comp_type == 'Evaporator' and 'outlet' in port_name:
                tooltip_lines.append("📍 <b>Map to:</b> Evaporator Outlet Temperature (°F)")
                tooltip_lines.append("🎯 <b>Used for:</b> State 2a (Evaporator Outlet)")
                tooltip_lines.append("📊 <b>Calculation:</b> Superheat, Cooling capacity")
            elif comp_type == 'Condenser' and port_name == 'outlet':
                tooltip_lines.append("📍 <b>Map to:</b> Condenser Outlet Temperature (°F)")
                tooltip_lines.append("🎯 <b>Used for:</b> State 4a (Condenser Outlet)")
                tooltip_lines.append("📊 <b>Calculation:</b> Subcooling")
            else:
                tooltip_lines.append("🔴 <b>Outlet connection point</b>")
                tooltip_lines.append("💡 Can also map temperature sensor here")
            
            # Add special handling for condenser air/water ports
            if comp_type == 'Condenser':
                if port_name == 'air_in_temp':
                    tooltip_lines = [
                        f"<b>Air Inlet Temperature</b>",
                        f"<i>Sensor Port (Air Cooled)</i>",
                        "",
                        "📍 <b>Map to:</b> Ambient Air Temperature (°F)",
                        "🎯 <b>Used for:</b> Condenser performance analysis",
                        "📊 <b>Calculation:</b> Heat rejection, condenser efficiency",
                        "",
                        "💡 <i>Click to map CSV column to this port</i>"
                    ]
                elif port_name == 'air_out_temp':
                    tooltip_lines = [
                        f"<b>Air Outlet Temperature</b>",
                        f"<i>Sensor Port (Air Cooled)</i>",
                        "",
                        "📍 <b>Map to:</b> Condenser Air Outlet Temperature (°F)",
                        "🎯 <b>Used for:</b> Condenser performance analysis",
                        "📊 <b>Calculation:</b> Heat rejection, condenser efficiency",
                        "",
                        "💡 <i>Click to map CSV column to this port</i>"
                    ]
                elif port_name == 'water_in_temp':
                    tooltip_lines = [
                        f"<b>Water Inlet Temperature</b>",
                        f"<i>Sensor Port (Water Cooled)</i>",
                        "",
                        "📍 <b>Map to:</b> Cooling Water Inlet Temperature (°F)",
                        "🎯 <b>Used for:</b> Condenser performance analysis",
                        "📊 <b>Calculation:</b> Heat rejection, condenser efficiency",
                        "",
                        "💡 <i>Click to map CSV column to this port</i>"
                    ]
                elif port_name == 'water_out_temp':
                    tooltip_lines = [
                        f"<b>Water Outlet Temperature</b>",
                        f"<i>Sensor Port (Water Cooled)</i>",
                        "",
                        "📍 <b>Map to:</b> Cooling Water Outlet Temperature (°F)",
                        "🎯 <b>Used for:</b> Condenser performance analysis",
                        "📊 <b>Calculation:</b> Heat rejection, condenser efficiency",
                        "",
                        "💡 <i>Click to map CSV column to this port</i>"
                    ]
            
            tooltip_lines.append("")
            tooltip_lines.append("💡 <i>Click to map CSV column or connect pipe</i>")
        else:
            tooltip_lines = [
                f"<b>{label}</b>",
                f"<i>{port_type.title()} Port</i>",
                "",
                "💡 <i>Click to interact</i>"
            ]
        
        tooltip = "<br>".join(tooltip_lines)
        self.setToolTip(tooltip)
    
    def hoverEnterEvent(self, event):
        """Highlight on hover."""
        # IMPROVED: Brighter, more visible hover effect
        self.setPen(QPen(Qt.GlobalColor.yellow, 3))
        self.setScale(1.2)
        super().hoverEnterEvent(event)
    
    def hoverLeaveEvent(self, event):
        """Remove highlight."""
        # IMPROVED: Match the new thicker border
        self.setPen(QPen(Qt.GlobalColor.white, 2))
        self.setScale(1.0)
        super().hoverLeaveEvent(event)
    
    def mousePressEvent(self, event):
        """Handle mouse clicks on sensor ports."""
        if event.button() == Qt.MouseButton.LeftButton:
            port_type = self.port_def.get('type', 'any')
            # If this is a sensor port, notify the diagram widget
            if port_type == 'sensor':
                # Get the diagram widget through the scene
                if self.scene() and hasattr(self.scene(), 'views'):
                    views = self.scene().views()
                    if views:
                        view = views[0]
                        diagram_widget = view.parent()
                        if diagram_widget and hasattr(diagram_widget, 'on_sensor_port_clicked'):
                            diagram_widget.on_sensor_port_clicked(self)
                            event.accept()
                            return
        super().mousePressEvent(event)
    
    def get_scene_position(self):
        """Returns the center position of the port in scene coordinates."""
        return self.scenePos()
    
    def add_connected_pipe(self, pipe_item):
        """Track a pipe connected to this port."""
        if pipe_item not in self.connected_pipes:
            self.connected_pipes.append(pipe_item)
    
    def remove_connected_pipe(self, pipe_item):
        """Remove a pipe from tracking."""
        if pipe_item in self.connected_pipes:
            self.connected_pipes.remove(pipe_item)


class JunctionComponentItem(QGraphicsPathItem):
    """A junction component drawn as connecting lines instead of a box."""
    
    def __init__(self, component_id, component_data, data_manager):
        super().__init__()
        self.component_id = component_id
        self.component_data = component_data
        self.data_manager = data_manager
        self.schema = SCHEMAS.get(component_data['type'], {})
        
        # Initialize ports first
        self.ports = {}
        
        # Visual setup - thick black lines for professional schematic look
        self.setPen(QPen(QColor("#000000"), 4))
        self.setBrush(QBrush(Qt.GlobalColor.transparent))
        
        # Interaction flags
        self.setFlag(QGraphicsItem.GraphicsItemFlag.ItemIsMovable, True)
        self.setFlag(QGraphicsItem.GraphicsItemFlag.ItemIsSelectable, True)
        self.setFlag(QGraphicsItem.GraphicsItemFlag.ItemSendsGeometryChanges, True)
        self.setCacheMode(QGraphicsItem.CacheMode.DeviceCoordinateCache)
        
        # Set position from data
        pos = component_data.get('position', [0, 0])
        if isinstance(pos, QPointF):
            self.setPos(pos)
        else:
            self.setPos(pos[0], pos[1])
        
        # Set rotation from data
        rotation = component_data.get('rotation', 0)
        self.setRotation(rotation)
        
        # Build the junction shape and ports
        self.rebuild_ports()
        self.update_shape()
    
    def rebuild_ports(self):
        """Rebuild all ports based on inlet/outlet counts."""
        # IMPORTANT: Save pipe connections before clearing ports
        port_connections = {}
        for port_name, port_item in self.ports.items():
            if hasattr(port_item, 'connected_pipes') and port_item.connected_pipes:
                port_connections[port_name] = list(port_item.connected_pipes)
        
        # Clear existing ports (they're child items, so just delete them)
        for port_item in list(self.ports.values()):
            port_item.setParentItem(None)  # Remove from parent
            if port_item.scene():
                port_item.scene().removeItem(port_item)
        self.ports.clear()
        
        # Get inlet and outlet counts
        inlet_count = self.component_data.get('properties', {}).get('inlet_count', 2)
        outlet_count = self.component_data.get('properties', {}).get('outlet_count', 1)
        
        # Spacing between ports (configurable)
        port_spacing = self.component_data.get('properties', {}).get('port_spacing', 20)
        
        # Professional T/L/+ layout: ports at ends of clean junction branches.
        # Use GRID_SIZE multiples (40) for symmetric snapping - avoids uneven arms.
        bar_half = 40
        stem_len = 40
        
        def pos(x, y):
            return (_snap_port_pos(x), _snap_port_pos(y))
        
        inlet_positions = []
        outlet_positions = []
        inlet_norms = []
        outlet_norms = []
        
        if inlet_count == 1 and outlet_count == 1:
            inlet_positions = [pos(-bar_half, 0)]
            outlet_positions = [pos(bar_half, 0)]
            inlet_norms = [[0, 0.5]]      # left edge
            outlet_norms = [[1, 0.5]]     # right edge
        elif inlet_count == 2 and outlet_count == 1:
            inlet_positions = [pos(-bar_half, 0), pos(bar_half, 0)]
            outlet_positions = [pos(0, stem_len)]
            inlet_norms = [[0, 0.5], [1, 0.5]]   # left, right
            outlet_norms = [[0.5, 1]]             # bottom
        elif inlet_count == 1 and outlet_count == 2:
            inlet_positions = [pos(0, -stem_len)]
            outlet_positions = [pos(-bar_half, 0), pos(bar_half, 0)]
            inlet_norms = [[0.5, 0]]              # top
            outlet_norms = [[0, 0.5], [1, 0.5]]  # left, right
        elif inlet_count == 2 and outlet_count == 2:
            inlet_positions = [pos(-bar_half, 0), pos(bar_half, 0)]
            outlet_positions = [pos(0, stem_len), pos(0, -stem_len)]
            inlet_norms = [[0, 0.5], [1, 0.5]]
            outlet_norms = [[0.5, 1], [0.5, 0]]   # bottom, top
        else:
            inlet_height = (inlet_count - 1) * port_spacing
            inlet_x = _snap_port_pos(-bar_half)
            for i in range(inlet_count):
                y_pos = _snap_port_pos(i * port_spacing - inlet_height / 2)
                inlet_positions.append((inlet_x, y_pos))
                inlet_norms.append([0, 0.5])
            outlet_height = (outlet_count - 1) * port_spacing
            outlet_x = _snap_port_pos(bar_half)
            for i in range(outlet_count):
                y_pos = _snap_port_pos(i * port_spacing - outlet_height / 2)
                outlet_positions.append((outlet_x, y_pos))
                outlet_norms.append([1, 0.5])
        
        for i, (px, py) in enumerate(inlet_positions):
            port_name = f"inlet_{i+1}"
            port_def = {
                'name': port_name,
                'type': 'in',
                'fluid_state': 'any',
                'pressure_side': 'any',
                'position': inlet_norms[i] if i < len(inlet_norms) else [0, 0.5]
            }
            port_item = PortItem(port_name, port_def, self)
            port_item.setPos(px, py)
            self.ports[port_name] = port_item
        
        for i, (px, py) in enumerate(outlet_positions):
            port_name = f"outlet_{i+1}"
            port_def = {
                'name': port_name,
                'type': 'out',
                'fluid_state': 'any',
                'pressure_side': 'any',
                'position': outlet_norms[i] if i < len(outlet_norms) else [1, 0.5]
            }
            port_item = PortItem(port_name, port_def, self)
            port_item.setPos(px, py)
            self.ports[port_name] = port_item
        
        # IMPORTANT: Restore pipe connections to ports with matching names
        total_restored = 0
        comp_type = self.component_data['type']
        for port_name, pipes in port_connections.items():
            if port_name in self.ports:
                new_port = self.ports[port_name]
                for pipe in pipes:
                    # Add connection to new port
                    if hasattr(new_port, 'add_connected_pipe'):
                        new_port.add_connected_pipe(pipe)
                    # Update pipe's internal port references
                    if hasattr(pipe, 'start_port_item') and hasattr(pipe, 'end_port_item'):
                        if hasattr(pipe, 'pipe_data') and hasattr(pipe, 'pipe_id'):
                            pipe_data = pipe.pipe_data
                            start_comp_id = pipe_data.get('start_component_id')
                            start_port = pipe_data.get('start_port')
                            end_comp_id = pipe_data.get('end_component_id')
                            end_port = pipe_data.get('end_port')
                            
                            if start_comp_id == self.component_id and start_port == port_name:
                                pipe.start_port_item = new_port
                            if end_comp_id == self.component_id and end_port == port_name:
                                pipe.end_port_item = new_port
                    if hasattr(pipe, 'update_path'):
                        pipe.update_path()
                    total_restored += 1
        
        if total_restored > 0:
            print(f"[REBUILD] Restored {total_restored} pipe connections to {comp_type}")
        
        # Update the visual shape after ports are rebuilt
        self.update_shape()
        # Update any connected pipes
        self.update_connected_pipes()
    
    def update_shape(self):
        """Update the junction shape based on port configuration.
        Draws clean T, L, or + shapes with thick black lines.
        Uses GRID_SIZE multiples (40) for symmetric snapping."""
        inlet_count = self.component_data.get('properties', {}).get('inlet_count', 2)
        outlet_count = self.component_data.get('properties', {}).get('outlet_count', 1)
        port_spacing = self.component_data.get('properties', {}).get('port_spacing', 20)

        bar_half = 40
        stem_len = 40

        def snap(x, y):
            return QPointF(_snap_port_pos(x), _snap_port_pos(y))

        path = QPainterPath()

        if inlet_count == 1 and outlet_count == 1:
            path.moveTo(snap(-bar_half, 0))
            path.lineTo(snap(bar_half, 0))
        elif inlet_count == 2 and outlet_count == 1:
            path.moveTo(snap(-bar_half, 0))
            path.lineTo(snap(bar_half, 0))
            path.moveTo(snap(0, 0))
            path.lineTo(snap(0, stem_len))
        elif inlet_count == 1 and outlet_count == 2:
            path.moveTo(snap(-bar_half, 0))
            path.lineTo(snap(bar_half, 0))
            path.moveTo(snap(0, -stem_len))
            path.lineTo(snap(0, 0))
        elif inlet_count == 2 and outlet_count == 2:
            path.moveTo(snap(-bar_half, 0))
            path.lineTo(snap(bar_half, 0))
            path.moveTo(snap(0, -stem_len))
            path.lineTo(snap(0, stem_len))
        else:
            inlet_x = _snap_port_pos(-bar_half)
            outlet_x = _snap_port_pos(bar_half)
            inlet_height = (inlet_count - 1) * port_spacing
            outlet_height = (outlet_count - 1) * port_spacing
            path.moveTo(inlet_x, 0)
            path.lineTo(outlet_x, 0)
            for i in range(inlet_count):
                y_pos = _snap_port_pos(i * port_spacing - inlet_height / 2)
                path.moveTo(inlet_x, 0)
                path.lineTo(inlet_x, y_pos)
            for i in range(outlet_count):
                y_pos = _snap_port_pos(i * port_spacing - outlet_height / 2)
                path.moveTo(outlet_x, 0)
                path.lineTo(outlet_x, y_pos)

        self.setPath(path)
    
    def boundingRect(self):
        """Return the bounding rectangle for the junction."""
        return self.path().boundingRect().adjusted(-10, -10, 10, 10)
    
    def itemChange(self, change, value):
        """Handle item changes."""
        if change == QGraphicsItem.GraphicsItemChange.ItemPositionChange:
            return snap_to_grid(value)
        if change == QGraphicsItem.GraphicsItemChange.ItemPositionHasChanged:
            # Update position in model
            self.data_manager.update_component_position(self.component_id, value)
            self.update_connected_pipes()

        if change == QGraphicsItem.GraphicsItemChange.ItemRotationHasChanged:
            # Save rotation to model
            self.component_data['rotation'] = value
            self.update_connected_pipes()

        return super().itemChange(change, value)

    def update_connected_pipes(self):
        """Update all pipes connected to this component's ports."""
        for port_item in self.ports.values():
            for pipe_item in port_item.connected_pipes:
                pipe_item.update_path()
    
    def mouseDoubleClickEvent(self, event):
        """Handle double-click to open property dialog."""
        if event.button() == Qt.MouseButton.LeftButton:
            if hasattr(self.scene(), 'views') and self.scene().views():
                view = self.scene().views()[0]
                if hasattr(view.parent(), 'on_component_double_clicked'):
                    view.parent().on_component_double_clicked(self)
        super().mouseDoubleClickEvent(event)


class TXVComponentItem(QGraphicsPathItem):
    """A TXV component drawn as two triangles (hourglass/bow-tie shape)."""
    
    def __init__(self, component_id, component_data, data_manager):
        super().__init__()
        self.component_id = component_id
        self.component_data = component_data
        self.data_manager = data_manager
        self.schema = SCHEMAS.get(component_data['type'], {})
        
        # Initialize ports
        self.ports = {}
        
        # Visual setup - black outline with blue interior
        self.setPen(QPen(QColor("#000000"), 3))  # Black outline
        self.setBrush(QBrush(QColor("#E3F2FD")))  # Light blue fill
        
        # Interaction flags
        self.setFlag(QGraphicsItem.GraphicsItemFlag.ItemIsMovable, True)
        self.setFlag(QGraphicsItem.GraphicsItemFlag.ItemIsSelectable, True)
        self.setFlag(QGraphicsItem.GraphicsItemFlag.ItemSendsGeometryChanges, True)
        self.setCacheMode(QGraphicsItem.CacheMode.DeviceCoordinateCache)
        
        # Set position from data
        pos = component_data.get('position', [0, 0])
        if isinstance(pos, QPointF):
            self.setPos(pos)
        else:
            self.setPos(pos[0], pos[1])
        
        # Set rotation from data
        rotation = component_data.get('rotation', 0)
        self.setRotation(rotation)
        
        # Build the TXV shape and ports
        self.rebuild_ports()
        self.update_shape()
    
    def rebuild_ports(self):
        """Create ports: inlet (top), outlet (bottom), and bulb (center) unless Cap Tube."""
        # IMPORTANT: Save pipe connections before clearing ports
        port_connections = {}
        for port_name, port_item in self.ports.items():
            if hasattr(port_item, 'connected_pipes') and port_item.connected_pipes:
                port_connections[port_name] = list(port_item.connected_pipes)

        # Clear existing ports
        for port_item in list(self.ports.values()):
            port_item.setParentItem(None)
            if port_item.scene():
                port_item.scene().removeItem(port_item)
        self.ports.clear()

        # Determine expansion device type (TXV or Cap Tube)
        exp_type = self.component_data.get('properties', {}).get('expansion_device_type', 'TXV')

        # Inlet at top (high pressure)
        inlet_def = {'name': 'inlet', 'type': 'in', 'fluid_state': 'liquid', 'pressure_side': 'high', 'position': [0.5, 0]}
        inlet_port = PortItem('inlet', inlet_def, self)
        inlet_port.setPos(0, -GRID_SIZE * 2)  # -40 (symmetric, grid-aligned)
        self.ports['inlet'] = inlet_port

        # Outlet at bottom (low pressure)
        outlet_def = {'name': 'outlet', 'type': 'out', 'fluid_state': 'two-phase', 'pressure_side': 'low', 'position': [0.5, 1]}
        outlet_port = PortItem('outlet', outlet_def, self)
        outlet_port.setPos(0, GRID_SIZE * 2)  # 40 (symmetric, grid-aligned)
        self.ports['outlet'] = outlet_port

        # Bulb (sensor) only for TXV — Cap Tube has no sensing bulb
        if exp_type != 'Cap Tube':
            bulb_def = {'name': 'bulb', 'type': 'sensor', 'fluid_state': 'any', 'pressure_side': 'low', 'position': [0.5, 0.5]}
            bulb_port = PortItem('bulb', bulb_def, self)
            bulb_port.setPos(0, 0)  # Exactly at the junction of the TXV cross
            self.ports['bulb'] = bulb_port

        # Update label text to reflect device type
        if hasattr(self, 'label'):
            self.label.setPlainText(exp_type)
        
        # IMPORTANT: Restore pipe connections to ports with matching names
        total_restored = 0
        comp_type = self.component_data['type']
        for port_name, pipes in port_connections.items():
            if port_name in self.ports:
                new_port = self.ports[port_name]
                for pipe in pipes:
                    # Add connection to new port
                    if hasattr(new_port, 'add_connected_pipe'):
                        new_port.add_connected_pipe(pipe)
                    # Update pipe's internal port references
                    if hasattr(pipe, 'start_port_item') and hasattr(pipe, 'end_port_item'):
                        if hasattr(pipe, 'pipe_data') and hasattr(pipe, 'pipe_id'):
                            pipe_data = pipe.pipe_data
                            start_comp_id = pipe_data.get('start_component_id')
                            start_port = pipe_data.get('start_port')
                            end_comp_id = pipe_data.get('end_component_id')
                            end_port = pipe_data.get('end_port')
                            
                            if start_comp_id == self.component_id and start_port == port_name:
                                pipe.start_port_item = new_port
                            if end_comp_id == self.component_id and end_port == port_name:
                                pipe.end_port_item = new_port
                    if hasattr(pipe, 'update_path'):
                        pipe.update_path()
                    total_restored += 1
        
        if total_restored > 0:
            print(f"[REBUILD] Restored {total_restored} pipe connections to {comp_type}")
    
    def update_shape(self):
        """Draw the bow-tie shape (two triangles touching at center)."""
        top_y = -GRID_SIZE * 2    # -40 (symmetric, grid-aligned)
        bottom_y = GRID_SIZE * 2  # 40 (symmetric, grid-aligned)

        path = QPainterPath()

        # Top triangle (pointing down)
        path.moveTo(-20, top_y)    # Top left
        path.lineTo(20, top_y)     # Top right
        path.lineTo(0, 0)          # Center point
        path.closeSubpath()

        # Bottom triangle (pointing up)
        path.moveTo(0, 0)              # Center point
        path.lineTo(-20, bottom_y)     # Bottom left
        path.lineTo(20, bottom_y)      # Bottom right
        path.closeSubpath()

        self.setPath(path)
    
    def boundingRect(self):
        """Return the bounding rectangle."""
        return self.path().boundingRect().adjusted(-10, -10, 10, 10)
    
    def itemChange(self, change, value):
        """Handle item changes."""
        if change == QGraphicsItem.GraphicsItemChange.ItemPositionChange:
            return snap_to_grid(value)
        if change == QGraphicsItem.GraphicsItemChange.ItemPositionHasChanged:
            self.data_manager.update_component_position(self.component_id, value)
            self.update_connected_pipes()

        if change == QGraphicsItem.GraphicsItemChange.ItemRotationHasChanged:
            self.component_data['rotation'] = value
            self.update_connected_pipes()

        return super().itemChange(change, value)
    
    def update_connected_pipes(self):
        """Update all pipes connected to this component's ports."""
        for port_item in self.ports.values():
            for pipe_item in port_item.connected_pipes:
                pipe_item.update_path()
    
    def mouseDoubleClickEvent(self, event):
        """Handle double-click to open property dialog."""
        if event.button() == Qt.MouseButton.LeftButton:
            if hasattr(self.scene(), 'views') and self.scene().views():
                view = self.scene().views()[0]
                if hasattr(view.parent(), 'on_component_double_clicked'):
                    view.parent().on_component_double_clicked(self)
        super().mouseDoubleClickEvent(event)


class HotGasBypassItem(QGraphicsPathItem):
    """A Hot Gas Bypass Valve component drawn as a valve with a solenoid."""
    
    def __init__(self, component_id, component_data, data_manager):
        super().__init__()
        self.component_id = component_id
        self.component_data = component_data
        self.data_manager = data_manager
        self.schema = SCHEMAS.get(component_data['type'], {})
        
        # Initialize ports
        self.ports = {}
        
        # Visual setup - black outline with light purple interior (distinct from TXV)
        self.setPen(QPen(QColor("#000000"), 3))  # Black outline
        self.setBrush(QBrush(QColor("#D1C4E9")))  # Light deep purple fill
        
        # Interaction flags
        self.setFlag(QGraphicsItem.GraphicsItemFlag.ItemIsMovable, True)
        self.setFlag(QGraphicsItem.GraphicsItemFlag.ItemIsSelectable, True)
        self.setFlag(QGraphicsItem.GraphicsItemFlag.ItemSendsGeometryChanges, True)
        self.setCacheMode(QGraphicsItem.CacheMode.DeviceCoordinateCache)
        
        # Set position from data
        pos = component_data.get('position', [0, 0])
        if isinstance(pos, QPointF):
            self.setPos(pos)
        else:
            self.setPos(pos[0], pos[1])
        
        # Set rotation from data
        rotation = component_data.get('rotation', 0)
        self.setRotation(rotation)
        
        # Build the shape and ports
        self.rebuild_ports()
        self.update_shape()
    
    def rebuild_ports(self):
        """Create the ports: inlet (top), outlet (right), solenoid (center/offset)."""
        # IMPORTANT: Save pipe connections before clearing ports
        port_connections = {}
        for port_name, port_item in self.ports.items():
            if hasattr(port_item, 'connected_pipes') and port_item.connected_pipes:
                port_connections[port_name] = list(port_item.connected_pipes)
        
        # Clear existing ports
        for port_item in list(self.ports.values()):
            port_item.setParentItem(None)
            if port_item.scene():
                port_item.scene().removeItem(port_item)
        self.ports.clear()
        
        # Inlet at top (High pressure gas from discharge)
        inlet_def = {'name': 'inlet', 'type': 'in', 'fluid_state': 'gas', 'pressure_side': 'high', 'position': [0.5, 0]}
        inlet_port = PortItem('inlet', inlet_def, self)
        inlet_port.setPos(0, -30)
        self.ports['inlet'] = inlet_port
        
        # Outlet at right (Low pressure to suction/evap inlet)
        outlet_def = {'name': 'outlet', 'type': 'out', 'fluid_state': 'two-phase', 'pressure_side': 'low', 'position': [1, 0.5]}
        outlet_port = PortItem('outlet', outlet_def, self)
        outlet_port.setPos(30, 0)
        self.ports['outlet'] = outlet_port
        
        # IMPORTANT: Restore pipe connections
        total_restored = 0
        comp_type = self.component_data['type']
        for port_name, pipes in port_connections.items():
            if port_name in self.ports:
                new_port = self.ports[port_name]
                for pipe in pipes:
                    if hasattr(new_port, 'add_connected_pipe'):
                        new_port.add_connected_pipe(pipe)
                    if hasattr(pipe, 'start_port_item') and hasattr(pipe, 'end_port_item'):
                        if hasattr(pipe, 'pipe_data') and hasattr(pipe, 'pipe_id'):
                            pipe_data = pipe.pipe_data
                            start_comp_id = pipe_data.get('start_component_id')
                            start_port = pipe_data.get('start_port')
                            end_comp_id = pipe_data.get('end_component_id')
                            end_port = pipe_data.get('end_port')
                            
                            if start_comp_id == self.component_id and start_port == port_name:
                                pipe.start_port_item = new_port
                            if end_comp_id == self.component_id and end_port == port_name:
                                pipe.end_port_item = new_port
                    if hasattr(pipe, 'update_path'):
                        pipe.update_path()
                    total_restored += 1
        
        if total_restored > 0:
            print(f"[REBUILD] Restored {total_restored} pipe connections to {comp_type}")
    
    def update_shape(self):
        """Draw a valve shape (bow-tie) with a solenoid box on top."""
        path = QPainterPath()

        # Bow-tie valve body (similar to TXV but rotated 90 deg visually or customized)
        # Vertical bow-tie to match inlet at top
        path.moveTo(-15, -15) # Top Left
        path.lineTo(15, -15)  # Top Right
        path.lineTo(0, 0)     # Center
        path.lineTo(15, 15)   # Bottom Right
        path.lineTo(-15, 15)  # Bottom Left
        path.lineTo(0, 0)     # Center
        path.closeSubpath()

        # Side output line
        path.moveTo(0, 0)
        path.lineTo(30, 0)

        self.setPath(path)
    
    def boundingRect(self):
        """Return the bounding rectangle."""
        return self.path().boundingRect().adjusted(-10, -10, 10, 10)
    
    def itemChange(self, change, value):
        """Handle item changes."""
        if change == QGraphicsItem.GraphicsItemChange.ItemPositionChange:
            return snap_to_grid(value)
        if change == QGraphicsItem.GraphicsItemChange.ItemPositionHasChanged:
            self.data_manager.update_component_position(self.component_id, value)
            self.update_connected_pipes()

        if change == QGraphicsItem.GraphicsItemChange.ItemRotationHasChanged:
            self.component_data['rotation'] = value
            self.update_connected_pipes()

        return super().itemChange(change, value)
    
    def itemChange(self, change, value):
        """Handle item changes."""
        if change == QGraphicsItem.GraphicsItemChange.ItemPositionChange:
            return snap_to_grid(value)
        if change == QGraphicsItem.GraphicsItemChange.ItemPositionHasChanged:
            self.data_manager.update_component_position(self.component_id, value)
            self.update_connected_pipes()

        if change == QGraphicsItem.GraphicsItemChange.ItemRotationHasChanged:
            self.component_data['rotation'] = value
            self.update_connected_pipes()

        return super().itemChange(change, value)

    def update_connected_pipes(self):
        """Update all pipes connected to this component's ports."""
        for port_item in self.ports.values():
            for pipe_item in port_item.connected_pipes:
                pipe_item.update_path()
    
    def mouseDoubleClickEvent(self, event):
        """Handle double-click to open property dialog."""
        if event.button() == Qt.MouseButton.LeftButton:
            if hasattr(self.scene(), 'views') and self.scene().views():
                view = self.scene().views()[0]
                if hasattr(view.parent(), 'on_component_double_clicked'):
                    view.parent().on_component_double_clicked(self)
        super().mouseDoubleClickEvent(event)


class HotGasLoopItem(BaseComponentItem):
    """A hot gas loop component drawn as a box with a coil inside."""
    
    def __init__(self, component_id, component_data, data_manager):
        super().__init__(component_id, component_data, data_manager)
        # BaseComponentItem handles the box and label
        # We just need to add the coil visual
        
        # Custom visual for the coil loop inside
        self.coil_path = QGraphicsPathItem(self)
        self.coil_path.setPen(QPen(QColor("#B71C1C"), 2))  # Dark red for hot gas
        self.coil_path.setBrush(QBrush(Qt.GlobalColor.transparent))
        self.update_coil_shape()
        
    def update_size(self, width, height):
        super().update_size(width, height)
        self.update_coil_shape()
        
    def update_coil_shape(self):
        """Draw a coil/loop pattern inside the box."""
        rect = self.rect()
        w = rect.width()
        h = rect.height()
        
        # Draw a simple sine wave / loop pattern
        path = QPainterPath()
        
        # Start at left (inlet side)
        path.moveTo(0, h/2)
        
        # Draw loops
        cycles = 3
        amplitude = h * 0.3
        step = w / (cycles * 2)
        
        for i in range(cycles * 2):
            x = (i + 1) * step
            # Alternate up and down
            y = h/2 + (amplitude if i % 2 == 0 else -amplitude)
            
            # Use cubic bezier for smooth curves
            prev_x = i * step
            ctrl1_x = prev_x + step/2
            ctrl2_x = x - step/2
            
            path.cubicTo(ctrl1_x, h/2, ctrl2_x, y, x, y)
             
        # End at right (outlet side)
        path.lineTo(w, h/2)
        
        self.coil_path.setPath(path)


class DistributorComponentItem(QGraphicsPathItem):
    """A distributor component drawn with double lines (like junction but distinguished)."""
    
    def __init__(self, component_id, component_data, data_manager):
        super().__init__()
        self.component_id = component_id
        self.component_data = component_data
        self.data_manager = data_manager
        self.schema = SCHEMAS.get(component_data['type'], {})
        
        # Initialize ports
        self.ports = {}
        
        # Visual setup - black double lines
        self.setPen(QPen(QColor("#000000"), 4))  # Black outline
        self.setBrush(QBrush(Qt.GlobalColor.transparent))
        
        # Interaction flags
        self.setFlag(QGraphicsItem.GraphicsItemFlag.ItemIsMovable, True)
        self.setFlag(QGraphicsItem.GraphicsItemFlag.ItemIsSelectable, True)
        self.setFlag(QGraphicsItem.GraphicsItemFlag.ItemSendsGeometryChanges, True)
        self.setCacheMode(QGraphicsItem.CacheMode.DeviceCoordinateCache)
        
        # Set position from data
        pos = component_data.get('position', [0, 0])
        if isinstance(pos, QPointF):
            self.setPos(pos)
        else:
            self.setPos(pos[0], pos[1])
        
        # Set rotation from data
        rotation = component_data.get('rotation', 0)
        self.setRotation(rotation)
        
        # Build the distributor shape and ports
        self.rebuild_ports()
        self.update_shape()
    
    def rebuild_ports(self):
        """Create ports: 1 inlet and multiple outlets based on circuit_count."""
        # IMPORTANT: Save pipe connections before clearing ports
        port_connections = {}
        for port_name, port_item in self.ports.items():
            if hasattr(port_item, 'connected_pipes') and port_item.connected_pipes:
                port_connections[port_name] = list(port_item.connected_pipes)
        
        # Clear existing ports
        for port_item in list(self.ports.values()):
            port_item.setParentItem(None)
            if port_item.scene():
                port_item.scene().removeItem(port_item)
        self.ports.clear()
        
        # Get circuit count and port spacing
        circuit_count = self.component_data.get('properties', {}).get('circuit_count', 1)
        port_spacing = self.component_data.get('properties', {}).get('port_spacing', 20)
        
        # Single inlet on the left (low pressure)
        inlet_def = {'name': 'inlet', 'type': 'in', 'fluid_state': 'two-phase', 'pressure_side': 'low', 'position': [0, 0.5]}
        inlet_port = PortItem('inlet', inlet_def, self)
        inlet_port.setPos(_snap_port_pos(-30), 0)
        self.ports['inlet'] = inlet_port

        # Multiple outlets on the right (low pressure)
        outlet_height = (circuit_count - 1) * port_spacing
        for i in range(circuit_count):
            port_name = f"outlet_{i+1}"
            outlet_def = {'name': port_name, 'type': 'out', 'fluid_state': 'two-phase', 'pressure_side': 'low', 'position': [1, 0.5]}
            outlet_port = PortItem(port_name, outlet_def, self)
            y_pos = _snap_port_pos(i * port_spacing - outlet_height / 2)
            outlet_port.setPos(_snap_port_pos(30), y_pos)
            self.ports[port_name] = outlet_port
        
        # IMPORTANT: Restore pipe connections to ports with matching names
        total_restored = 0
        comp_type = self.component_data['type']
        for port_name, pipes in port_connections.items():
            if port_name in self.ports:
                new_port = self.ports[port_name]
                for pipe in pipes:
                    # Add connection to new port
                    if hasattr(new_port, 'add_connected_pipe'):
                        new_port.add_connected_pipe(pipe)
                    # Update pipe's internal port references
                    if hasattr(pipe, 'start_port_item') and hasattr(pipe, 'end_port_item'):
                        if hasattr(pipe, 'pipe_data') and hasattr(pipe, 'pipe_id'):
                            pipe_data = pipe.pipe_data
                            start_comp_id = pipe_data.get('start_component_id')
                            start_port = pipe_data.get('start_port')
                            end_comp_id = pipe_data.get('end_component_id')
                            end_port = pipe_data.get('end_port')
                            
                            if start_comp_id == self.component_id and start_port == port_name:
                                pipe.start_port_item = new_port
                            if end_comp_id == self.component_id and end_port == port_name:
                                pipe.end_port_item = new_port
                    if hasattr(pipe, 'update_path'):
                        pipe.update_path()
                    total_restored += 1
        
        if total_restored > 0:
            print(f"[REBUILD] Restored {total_restored} pipe connections to {comp_type}")
        
        # Update the visual shape after ports are rebuilt
        self.update_shape()
        # Update any connected pipes
        self.update_connected_pipes()
    
    def update_shape(self):
        """Draw double lines to distinguish from junction."""
        circuit_count = self.component_data.get('properties', {}).get('circuit_count', 1)
        port_spacing = self.component_data.get('properties', {}).get('port_spacing', 20)

        inlet_x = _snap_port_pos(-30)    # -20
        outlet_x = _snap_port_pos(30)    # 40

        path = QPainterPath()

        # Double horizontal main lines (parallel lines with 4 pixel spacing)
        path.moveTo(inlet_x, -2)
        path.lineTo(outlet_x, -2)
        path.moveTo(inlet_x, 2)
        path.lineTo(outlet_x, 2)

        # Inlet double vertical line
        path.moveTo(inlet_x - 2, -2)
        path.lineTo(inlet_x - 2, 0)
        path.moveTo(inlet_x + 2, -2)
        path.lineTo(inlet_x + 2, 0)

        # Outlet double vertical lines
        outlet_height = (circuit_count - 1) * port_spacing
        for i in range(circuit_count):
            y_pos = _snap_port_pos(i * port_spacing - outlet_height / 2)
            path.moveTo(outlet_x - 2, 0)
            path.lineTo(outlet_x - 2, y_pos)
            path.moveTo(outlet_x + 2, 0)
            path.lineTo(outlet_x + 2, y_pos)

        self.setPath(path)
    
    def boundingRect(self):
        """Return the bounding rectangle."""
        return self.path().boundingRect().adjusted(-10, -10, 10, 10)
    
    def itemChange(self, change, value):
        """Handle item changes."""
        if change == QGraphicsItem.GraphicsItemChange.ItemPositionChange:
            return snap_to_grid(value)
        if change == QGraphicsItem.GraphicsItemChange.ItemPositionHasChanged:
            self.data_manager.update_component_position(self.component_id, value)
            self.update_connected_pipes()

        if change == QGraphicsItem.GraphicsItemChange.ItemRotationHasChanged:
            self.component_data['rotation'] = value
            self.update_connected_pipes()

        return super().itemChange(change, value)
    
    def update_connected_pipes(self):
        """Update all pipes connected to this component's ports."""
        for port_item in self.ports.values():
            for pipe_item in port_item.connected_pipes:
                pipe_item.update_path()
    
    def mouseDoubleClickEvent(self, event):
        """Handle double-click to open property dialog."""
        if event.button() == Qt.MouseButton.LeftButton:
            if hasattr(self.scene(), 'views') and self.scene().views():
                view = self.scene().views()[0]
                if hasattr(view.parent(), 'on_component_double_clicked'):
                    view.parent().on_component_double_clicked(self)
        super().mouseDoubleClickEvent(event)


class SensorBulbComponentItem(QGraphicsPathItem):
    """A sensor bulb component drawn as a rounded rectangle with 'S' inside."""
    
    def __init__(self, component_id, component_data, data_manager):
        super().__init__()
        self.component_id = component_id
        self.component_data = component_data
        self.data_manager = data_manager
        self.schema = SCHEMAS.get(component_data['type'], {})
        
        # Initialize ports
        self.ports = {}
        
        # Visual setup - rounded rectangle with blue fill and black outline
        self.setPen(QPen(QColor("#000000"), 3))  # Black outline
        self.setBrush(QBrush(QColor("#E3F2FD")))  # Light blue fill
        
        # Create "S" label centered
        self.label = QGraphicsTextItem("S", self)
        self.label.setDefaultTextColor(QColor("#000000"))
        font = self.label.font()
        font.setPointSize(20)
        font.setBold(True)
        self.label.setFont(font)
        # Center the "S" in the rounded rectangle
        self.label.setPos(12, 5)
        
        # Interaction flags
        self.setFlag(QGraphicsItem.GraphicsItemFlag.ItemIsMovable, True)
        self.setFlag(QGraphicsItem.GraphicsItemFlag.ItemIsSelectable, True)
        self.setFlag(QGraphicsItem.GraphicsItemFlag.ItemSendsGeometryChanges, True)
        self.setCacheMode(QGraphicsItem.CacheMode.DeviceCoordinateCache)
        
        # Set position from data
        pos = component_data.get('position', [0, 0])
        if isinstance(pos, QPointF):
            self.setPos(pos)
        else:
            self.setPos(pos[0], pos[1])
        
        # Set rotation from data
        rotation = component_data.get('rotation', 0)
        self.setRotation(rotation)
        
        # Build the rounded rectangle shape and sensor port
        self.update_shape()
        self.rebuild_ports()
    
    def update_shape(self):
        """Draw the rounded rectangle shape."""
        from PyQt6.QtCore import QRectF
        from PyQt6.QtGui import QPainterPath
        
        path = QPainterPath()
        # Create rounded rectangle: 40x40 with corner radius of 8
        rect = QRectF(0, 0, 40, 40)
        path.addRoundedRect(rect, 8, 8)
        
        self.setPath(path)
    
    def rebuild_ports(self):
        """Create the sensor port on the right perimeter of the rounded rectangle."""
        # IMPORTANT: Save pipe connections before clearing ports
        port_connections = {}
        for port_name, port_item in self.ports.items():
            if hasattr(port_item, 'connected_pipes') and port_item.connected_pipes:
                port_connections[port_name] = list(port_item.connected_pipes)
        
        # Clear existing ports
        for port_item in list(self.ports.values()):
            port_item.setParentItem(None)
            if port_item.scene():
                port_item.scene().removeItem(port_item)
        self.ports.clear()
        
        # Measurement point on the right perimeter
        # Position the port exactly at the perimeter (x=40) so the connection line stops at the bulb edge
        sensor_def = {'name': 'measurement', 'type': 'sensor', 'fluid_state': 'any', 'pressure_side': 'any', 'position': [1.0, 0.5]}
        sensor_port = PortItem('measurement', sensor_def, self)
        sensor_port.setPos(40, 20)  # Exactly at the right edge of the 40x40 rounded rectangle (stops at perimeter)
        self.ports['measurement'] = sensor_port
        
        # IMPORTANT: Restore pipe connections to ports with matching names
        total_restored = 0
        comp_type = self.component_data['type']
        for port_name, pipes in port_connections.items():
            if port_name in self.ports:
                new_port = self.ports[port_name]
                for pipe in pipes:
                    # Add connection to new port
                    if hasattr(new_port, 'add_connected_pipe'):
                        new_port.add_connected_pipe(pipe)
                    # Update pipe's internal port references
                    if hasattr(pipe, 'start_port_item') and hasattr(pipe, 'end_port_item'):
                        if hasattr(pipe, 'pipe_data') and hasattr(pipe, 'pipe_id'):
                            pipe_data = pipe.pipe_data
                            start_comp_id = pipe_data.get('start_component_id')
                            start_port = pipe_data.get('start_port')
                            end_comp_id = pipe_data.get('end_component_id')
                            end_port = pipe_data.get('end_port')
                            
                            if start_comp_id == self.component_id and start_port == port_name:
                                pipe.start_port_item = new_port
                            if end_comp_id == self.component_id and end_port == port_name:
                                pipe.end_port_item = new_port
                    if hasattr(pipe, 'update_path'):
                        pipe.update_path()
                    total_restored += 1
        
        if total_restored > 0:
            print(f"[REBUILD] Restored {total_restored} pipe connections to {comp_type}")
    
    def boundingRect(self):
        """Return the bounding rectangle."""
        return self.path().boundingRect().adjusted(-10, -10, 10, 10)
    
    def itemChange(self, change, value):
        """Handle item changes."""
        if change == QGraphicsItem.GraphicsItemChange.ItemPositionChange:
            return snap_to_grid(value)
        if change == QGraphicsItem.GraphicsItemChange.ItemPositionHasChanged:
            self.data_manager.update_component_position(self.component_id, value)
            self.update_connected_pipes()

        if change == QGraphicsItem.GraphicsItemChange.ItemRotationHasChanged:
            self.component_data['rotation'] = value
            self.update_connected_pipes()

        return super().itemChange(change, value)
    
    def update_connected_pipes(self):
        """Update all pipes connected to this component's ports."""
        for port_item in self.ports.values():
            for pipe_item in port_item.connected_pipes:
                pipe_item.update_path()
    
    def mouseDoubleClickEvent(self, event):
        """Handle double-click to open property dialog."""
        if event.button() == Qt.MouseButton.LeftButton:
            if hasattr(self.scene(), 'views') and self.scene().views():
                view = self.scene().views()[0]
                if hasattr(view.parent(), 'on_component_double_clicked'):
                    view.parent().on_component_double_clicked(self)
        super().mouseDoubleClickEvent(event)


class FanComponentItem(QGraphicsPathItem):
    """A fan component drawn with fan blade shape."""
    
    def __init__(self, component_id, component_data, data_manager):
        super().__init__()
        self.component_id = component_id
        self.component_data = component_data
        self.data_manager = data_manager
        self.schema = SCHEMAS.get(component_data['type'], {})
        
        # MIGRATION: Convert old property names to new ones for backward compatibility
        self._migrate_old_properties()
        
        # Initialize ports
        self.ports = {}
        
        # Visual setup - fan shape with blue fill and black outline
        self.setPen(QPen(QColor("#000000"), 3))  # Black outline
        self.setBrush(QBrush(QColor("#E3F2FD")))  # Light blue fill
        
        # Interaction flags
        self.setFlag(QGraphicsItem.GraphicsItemFlag.ItemIsMovable, True)
        self.setFlag(QGraphicsItem.GraphicsItemFlag.ItemIsSelectable, True)
        self.setFlag(QGraphicsItem.GraphicsItemFlag.ItemSendsGeometryChanges, True)
        self.setCacheMode(QGraphicsItem.CacheMode.DeviceCoordinateCache)
        
        # Set position from data
        pos = component_data.get('position', [0, 0])
        if isinstance(pos, QPointF):
            self.setPos(pos)
        else:
            self.setPos(pos[0], pos[1])
        
        # Set rotation from data
        rotation = component_data.get('rotation', 0)
        self.setRotation(rotation)
        
        # Build the fan shape and ports
        self.rebuild_ports()
        self.update_shape()
    
    def _migrate_old_properties(self):
        """Convert old property names to new schema format for backward compatibility."""
        props = self.component_data.get('properties', {})
        
        # Migration: air_direction -> air_flow_type
        if 'air_direction' in props and 'air_flow_type' not in props:
            old_value = props['air_direction']
            # Map old direction values to new flow type format if needed
            if old_value in ['up', 'down', 'left', 'right']:
                # Old arrow-based system - convert to Air Inlet (default)
                props['air_flow_type'] = 'Air Inlet'
                print(f"[FAN MIGRATION] Converted air_direction '{old_value}' to air_flow_type 'Air Inlet'")
            elif old_value in ['Air Inlet', 'Air Outlet']:
                # Already in new format
                props['air_flow_type'] = old_value
            else:
                # Default to Air Inlet
                props['air_flow_type'] = 'Air Inlet'
            
            # Remove old property
            del props['air_direction']
            self.component_data['properties'] = props
    
    def rebuild_ports(self):
        """Rebuild dynamic sensor ports based on sensor_count property."""
        # IMPORTANT: Save pipe connections before clearing ports
        port_connections = {}
        for port_name, port_item in self.ports.items():
            if hasattr(port_item, 'connected_pipes') and port_item.connected_pipes:
                port_connections[port_name] = list(port_item.connected_pipes)
        
        try:
            # Clear existing ports
            for port_item in list(self.ports.values()):
                try:
                    port_item.setParentItem(None)
                except:
                    pass
                try:
                    if port_item.scene():
                        port_item.scene().removeItem(port_item)
                except:
                    pass
            self.ports.clear()
            
            # Get sensor count from properties (default 6 if not specified)
            sensor_count = self.component_data.get('properties', {}).get('sensor_count', 6)
            
            if sensor_count > 0:
                # Create dynamic sensor ports (sensor_0, sensor_1, etc.)
                # SYMMETRIC PLACEMENT: Center sensors around y=0
                total_span = 40  # Vertical span for sensor distribution (-20 to 20)

                for i in range(int(sensor_count)):
                    port_name = f"sensor_{i}"
                    port_def = {
                        'name': port_name,
                        'type': 'sensor',
                        'fluid_state': 'any',
                        'pressure_side': 'any',
                        'position': [1, i / max(sensor_count - 1, 1)]
                    }

                    # Calculate symmetric position centered at y=0
                    if sensor_count == 1:
                        port_y = 0  # Single sensor at center
                    else:
                        # Evenly distribute sensors symmetrically around center
                        spacing = total_span / (sensor_count - 1)
                        port_y = -(total_span / 2) + (i * spacing)

                    port_x = _snap_port_pos(35)  # Right side of fan (snapped to grid)
                    port_y = _snap_port_pos(port_y)

                    # Create port and position it
                    port_item = PortItem(port_name, port_def, self)
                    port_item.setPos(port_x, port_y)
                    self.ports[port_name] = port_item
            
            # IMPORTANT: Restore pipe connections to ports with matching names
            total_restored = 0
            comp_type = self.component_data['type']
            for port_name, pipes in port_connections.items():
                if port_name in self.ports:
                    new_port = self.ports[port_name]
                    for pipe in pipes:
                        # Add connection to new port
                        if hasattr(new_port, 'add_connected_pipe'):
                            new_port.add_connected_pipe(pipe)
                        # Update pipe's internal port references
                        if hasattr(pipe, 'start_port_item') and hasattr(pipe, 'end_port_item'):
                            if hasattr(pipe, 'pipe_data') and hasattr(pipe, 'pipe_id'):
                                pipe_data = pipe.pipe_data
                                start_comp_id = pipe_data.get('start_component_id')
                                start_port = pipe_data.get('start_port')
                                end_comp_id = pipe_data.get('end_component_id')
                                end_port = pipe_data.get('end_port')
                                
                                if start_comp_id == self.component_id and start_port == port_name:
                                    pipe.start_port_item = new_port
                                if end_comp_id == self.component_id and end_port == port_name:
                                    pipe.end_port_item = new_port
                        if hasattr(pipe, 'update_path'):
                            pipe.update_path()
                        total_restored += 1
            
            if total_restored > 0:
                print(f"[REBUILD] Restored {total_restored} pipe connections to {comp_type}")
            
        except Exception as e:
            print(f"[FAN] Error rebuilding ports: {e}")
            import traceback
            traceback.print_exc()
        finally:
            # Always try to update shape
            try:
                self.update_shape()
            except Exception as e:
                print(f"[FAN] Error in update_shape: {e}")
    
    def update_shape(self):
        """Draw fan blades in a circular pattern."""
        try:
            import math
            path = QPainterPath()
            
            # Outer circle (housing)
            center_x, center_y = 0, 0
            radius = 30
            path.addEllipse(center_x - radius, center_y - radius, radius * 2, radius * 2)
            
            # Draw 4 fan blades
            num_blades = 4
            for i in range(num_blades):
                angle = (360 / num_blades) * i
                angle_rad = math.radians(angle)
                
                # Blade is a curved shape from center outward
                blade_path = QPainterPath()
                
                # Start at center
                blade_path.moveTo(center_x, center_y)
                
                # Draw a curved blade
                # Point 1: Outward to one side
                angle1_rad = math.radians(angle - 15)
                x1 = center_x + math.cos(angle1_rad) * radius * 0.9
                y1 = center_y + math.sin(angle1_rad) * radius * 0.9
                
                # Point 2: Tip of blade
                x2 = center_x + math.cos(angle_rad) * radius * 0.85
                y2 = center_y + math.sin(angle_rad) * radius * 0.85
                
                # Point 3: Other side
                angle2_rad = math.radians(angle + 15)
                x3 = center_x + math.cos(angle2_rad) * radius * 0.9
                y3 = center_y + math.sin(angle2_rad) * radius * 0.9
                
                blade_path.lineTo(x1, y1)
                blade_path.lineTo(x2, y2)
                blade_path.lineTo(x3, y3)
                blade_path.closeSubpath()
                
                path.addPath(blade_path)
            
            # Center hub (small circle)
            hub_radius = 5
            path.addEllipse(center_x - hub_radius, center_y - hub_radius, hub_radius * 2, hub_radius * 2)
            
            self.setPath(path)
        except Exception as e:
            print(f"[FAN] Error updating shape: {e}")
            import traceback
            traceback.print_exc()
    
    def boundingRect(self):
        """Return the bounding rectangle."""
        return self.path().boundingRect().adjusted(-10, -10, 10, 10)
    
    def itemChange(self, change, value):
        """Handle item changes."""
        if change == QGraphicsItem.GraphicsItemChange.ItemPositionChange:
            return snap_to_grid(value)
        if change == QGraphicsItem.GraphicsItemChange.ItemPositionHasChanged:
            self.data_manager.update_component_position(self.component_id, value)
            self.update_connected_pipes()

        if change == QGraphicsItem.GraphicsItemChange.ItemRotationHasChanged:
            self.component_data['rotation'] = value
            self.update_connected_pipes()

        return super().itemChange(change, value)
    
    def update_connected_pipes(self):
        """Update all pipes connected to this component's ports."""
        for port_item in self.ports.values():
            for pipe_item in port_item.connected_pipes:
                pipe_item.update_path()
    
    def mouseDoubleClickEvent(self, event):
        """Handle double-click to open property dialog."""
        if event.button() == Qt.MouseButton.LeftButton:
            if hasattr(self.scene(), 'views') and self.scene().views():
                view = self.scene().views()[0]
                if hasattr(view.parent(), 'on_component_double_clicked'):
                    view.parent().on_component_double_clicked(self)
        super().mouseDoubleClickEvent(event)


class AirSensorArrayComponentItem(QGraphicsRectItem):
    """Air sensor array block - horizontal rectangle with evenly spaced sensor dots."""
    
    def __init__(self, component_id, component_data, data_manager):
        # Get dimensions from properties
        width = component_data.get('properties', {}).get('block_width', 300)
        height = component_data.get('properties', {}).get('block_height', 25)
        
        super().__init__(0, 0, width, height)
        self.component_id = component_id
        self.component_data = component_data
        self.data_manager = data_manager
        self.schema = SCHEMAS.get(component_data['type'], {})
        
        from PyQt6.QtGui import QFont
        self.font = QFont('Arial', 9)
        
        # Initialize ports
        self.ports = {}
        
        # Visual setup - color based on curtain type
        curtain_type = component_data.get('properties', {}).get('curtain_type', 'Primary')
        if curtain_type == 'Primary':
            fill_color = QColor("#B3E5FC")  # Light blue (cooler air)
        elif curtain_type == 'Secondary':
            fill_color = QColor("#FFE0B2")  # Light orange (warmer)
        else:  # Return
            fill_color = QColor("#FFAB91")  # Darker red/orange (warmest air)
        
        self.setBrush(QBrush(fill_color))
        self.setPen(QPen(QColor("#000000"), 2))  # Black outline
        
        # Create label outside the rectangle
        label_text = f"{curtain_type} Air"
        self.label = QGraphicsTextItem(label_text, self)
        self.label.setDefaultTextColor(QColor("#000000"))
        # Position label above the rectangle
        self.label.setPos(5, -20)
        
        # Interaction flags
        self.setFlag(QGraphicsItem.GraphicsItemFlag.ItemIsMovable, True)
        self.setFlag(QGraphicsItem.GraphicsItemFlag.ItemIsSelectable, True)
        self.setFlag(QGraphicsItem.GraphicsItemFlag.ItemSendsGeometryChanges, True)
        self.setCacheMode(QGraphicsItem.CacheMode.DeviceCoordinateCache)
        
        # Set position from data
        pos = component_data.get('position', [0, 0])
        if isinstance(pos, QPointF):
            self.setPos(pos)
        else:
            self.setPos(pos[0], pos[1])
        
        # Set rotation from data
        rotation = component_data.get('rotation', 0)
        self.setRotation(rotation)
        
        # Build sensor ports
        self.rebuild_ports()
    
    def rebuild_ports(self):
        """Create evenly spaced sensor ports along the horizontal block."""
        # IMPORTANT: Save pipe connections before clearing ports
        port_connections = {}
        for port_name, port_item in self.ports.items():
            if hasattr(port_item, 'connected_pipes') and port_item.connected_pipes:
                port_connections[port_name] = list(port_item.connected_pipes)
        
        # Clear existing ports
        for port_item in list(self.ports.values()):
            port_item.setParentItem(None)
            if port_item.scene():
                port_item.scene().removeItem(port_item)
        self.ports.clear()
        
        # Get current properties
        sensor_count = self.component_data.get('properties', {}).get('sensor_count', 11)
        width = self.component_data.get('properties', {}).get('block_width', 300)
        height = self.component_data.get('properties', {}).get('block_height', 25)
        
        # Update rectangle size
        self.setRect(0, 0, width, height)
        
        # Update label
        curtain_type = self.component_data.get('properties', {}).get('curtain_type', 'Primary')
        self.label.setPlainText(f"{curtain_type} Air")
        
        # Update fill color based on curtain type
        if curtain_type == 'Primary':
            fill_color = QColor("#B3E5FC")  # Light blue (cooler)
        elif curtain_type == 'Secondary':
            fill_color = QColor("#FFE0B2")  # Light orange (warmer)
        else:  # Return
            fill_color = QColor("#FFAB91")  # Darker red/orange (warmest)
        self.setBrush(QBrush(fill_color))
        
        # Create sensor ports evenly spaced
        for i in range(sensor_count):
            # Calculate even spacing
            if sensor_count == 1:
                x_pos = width / 2
            else:
                spacing = width / (sensor_count + 1)
                x_pos = spacing * (i + 1)
            
            y_pos = height / 2
            
            # Create sensor port
            port_name = f"sensor_{i+1}"
            port_def = {
                'name': port_name,
                'type': 'sensor',
                'fluid_state': 'any',
                'pressure_side': 'any',
                'position': [x_pos / width, 0.5]
            }
            port_item = PortItem(port_name, port_def, self)
            port_item.setPos(x_pos, y_pos)
            self.ports[port_name] = port_item
        
        # IMPORTANT: Restore pipe connections to ports with matching names
        total_restored = 0
        comp_type = self.component_data['type']
        for port_name, pipes in port_connections.items():
            if port_name in self.ports:
                new_port = self.ports[port_name]
                for pipe in pipes:
                    # Add connection to new port
                    if hasattr(new_port, 'add_connected_pipe'):
                        new_port.add_connected_pipe(pipe)
                    # Update pipe's internal port references
                    if hasattr(pipe, 'start_port_item') and hasattr(pipe, 'end_port_item'):
                        if hasattr(pipe, 'pipe_data') and hasattr(pipe, 'pipe_id'):
                            pipe_data = pipe.pipe_data
                            start_comp_id = pipe_data.get('start_component_id')
                            start_port = pipe_data.get('start_port')
                            end_comp_id = pipe_data.get('end_component_id')
                            end_port = pipe_data.get('end_port')
                            
                            if start_comp_id == self.component_id and start_port == port_name:
                                pipe.start_port_item = new_port
                            if end_comp_id == self.component_id and end_port == port_name:
                                pipe.end_port_item = new_port
                    if hasattr(pipe, 'update_path'):
                        pipe.update_path()
                    total_restored += 1
        
        if total_restored > 0:
            print(f"[REBUILD] Restored {total_restored} pipe connections to {comp_type}")
    
    def update_size(self, width, height):
        """Update the block size and rebuild ports."""
        self.component_data['properties']['block_width'] = width
        self.component_data['properties']['block_height'] = height
        self.rebuild_ports()
    
    def itemChange(self, change, value):
        """Handle item changes."""
        if change == QGraphicsItem.GraphicsItemChange.ItemPositionChange:
            return snap_to_grid(value)
        if change == QGraphicsItem.GraphicsItemChange.ItemPositionHasChanged:
            self.data_manager.update_component_position(self.component_id, value)

        if change == QGraphicsItem.GraphicsItemChange.ItemRotationHasChanged:
            self.component_data['rotation'] = value

        return super().itemChange(change, value)

    def mouseDoubleClickEvent(self, event):
        """Handle double-click to open property dialog."""
        if event.button() == Qt.MouseButton.LeftButton:
            if hasattr(self.scene(), 'views') and self.scene().views():
                view = self.scene().views()[0]
                if hasattr(view.parent(), 'on_component_double_clicked'):
                    view.parent().on_component_double_clicked(self)
        super().mouseDoubleClickEvent(event)


class ShelvingGridComponentItem(QGraphicsPathItem):
    """Shelving grid with sensor dots at shelf corners - shared at junctions."""
    
    def __init__(self, component_id, component_data, data_manager):
        super().__init__()
        self.component_id = component_id
        self.component_data = component_data
        self.data_manager = data_manager
        self.schema = SCHEMAS.get(component_data['type'], {})
        
        # Initialize ports
        self.ports = {}
        
        # Visual setup
        self.setPen(QPen(QColor("#000000"), 2))  # Black outline for shelves
        self.setBrush(QBrush(Qt.GlobalColor.transparent))
        
        # Interaction flags
        self.setFlag(QGraphicsItem.GraphicsItemFlag.ItemIsMovable, True)
        self.setFlag(QGraphicsItem.GraphicsItemFlag.ItemIsSelectable, True)
        self.setFlag(QGraphicsItem.GraphicsItemFlag.ItemSendsGeometryChanges, True)
        self.setCacheMode(QGraphicsItem.CacheMode.DeviceCoordinateCache)
        
        # Set position from data
        pos = component_data.get('position', [0, 0])
        if isinstance(pos, QPointF):
            self.setPos(pos)
        else:
            self.setPos(pos[0], pos[1])
        
        # Set rotation from data
        rotation = component_data.get('rotation', 0)
        self.setRotation(rotation)
        
        # Build the grid
        self.rebuild_ports()
        self.update_shape()
    
    def rebuild_ports(self):
        """Create sensor ports at grid intersections (shelf corners)."""
        # IMPORTANT: Save pipe connections before clearing ports
        port_connections = {}
        for port_name, port_item in self.ports.items():
            if hasattr(port_item, 'connected_pipes') and port_item.connected_pipes:
                port_connections[port_name] = list(port_item.connected_pipes)
        
        # Clear existing ports
        for port_item in list(self.ports.values()):
            port_item.setParentItem(None)
            if port_item.scene():
                port_item.scene().removeItem(port_item)
        self.ports.clear()
        
        # Get properties
        props = self.component_data.get('properties', {})
        shelving_type = props.get('shelving_type', 'Modular')
        shelf_rows = props.get('shelf_rows', 6)
        shelf_width = props.get('shelf_width', 100)
        shelf_height = props.get('shelf_height', 60)
        row_gap = props.get('row_gap', 20)
        
        # Determine number of columns
        if shelving_type == 'Modular':
            columns = props.get('module_count', 3)
        else:  # Non-Modular
            columns = props.get('door_count', 3)
        
        # Create sensors at shelf corners - each row has top and bottom sensors
        # Sensors are shared horizontally within a row, but NOT between rows (due to gap)
        for row_idx in range(shelf_rows):
            # Y positions for this row
            top_y = row_idx * (shelf_height + row_gap)
            bottom_y = top_y + shelf_height
            
            # Top edge sensors for this row
            for col in range(columns + 1):
                x_pos = col * shelf_width
                port_name = f"sensor_r{row_idx}_top_c{col}"
                port_def = {
                    'name': port_name,
                    'type': 'sensor',
                    'fluid_state': 'any',
                    'pressure_side': 'any',
                    'position': [x_pos / (columns * shelf_width), top_y / ((shelf_height + row_gap) * shelf_rows)]
                }
                port_item = PortItem(port_name, port_def, self)
                port_item.setPos(x_pos, top_y)
                self.ports[port_name] = port_item
            
            # Bottom edge sensors for this row
            for col in range(columns + 1):
                x_pos = col * shelf_width
                port_name = f"sensor_r{row_idx}_bottom_c{col}"
                port_def = {
                    'name': port_name,
                    'type': 'sensor',
                    'fluid_state': 'any',
                    'pressure_side': 'any',
                    'position': [x_pos / (columns * shelf_width), bottom_y / ((shelf_height + row_gap) * shelf_rows)]
                }
                port_item = PortItem(port_name, port_def, self)
                port_item.setPos(x_pos, bottom_y)
                self.ports[port_name] = port_item
        
        # IMPORTANT: Restore pipe connections to ports with matching names
        total_restored = 0
        comp_type = self.component_data['type']
        for port_name, pipes in port_connections.items():
            if port_name in self.ports:
                new_port = self.ports[port_name]
                for pipe in pipes:
                    # Add connection to new port
                    if hasattr(new_port, 'add_connected_pipe'):
                        new_port.add_connected_pipe(pipe)
                    # Update pipe's internal port references
                    if hasattr(pipe, 'start_port_item') and hasattr(pipe, 'end_port_item'):
                        if hasattr(pipe, 'pipe_data') and hasattr(pipe, 'pipe_id'):
                            pipe_data = pipe.pipe_data
                            start_comp_id = pipe_data.get('start_component_id')
                            start_port = pipe_data.get('start_port')
                            end_comp_id = pipe_data.get('end_component_id')
                            end_port = pipe_data.get('end_port')
                            
                            if start_comp_id == self.component_id and start_port == port_name:
                                pipe.start_port_item = new_port
                            if end_comp_id == self.component_id and end_port == port_name:
                                pipe.end_port_item = new_port
                    if hasattr(pipe, 'update_path'):
                        pipe.update_path()
                    total_restored += 1
        
        if total_restored > 0:
            print(f"[REBUILD] Restored {total_restored} pipe connections to {comp_type}")

    def update_shape(self):
        """Draw the shelving grid - rectangles for each shelf row."""
        props = self.component_data.get('properties', {})
        shelving_type = props.get('shelving_type', 'Modular')
        shelf_rows = props.get('shelf_rows', 6)
        shelf_width = props.get('shelf_width', 100)
        shelf_height = props.get('shelf_height', 60)
        row_gap = props.get('row_gap', 20)
        
        # Determine number of columns
        if shelving_type == 'Modular':
            columns = props.get('module_count', 3)
        else:  # Non-Modular
            columns = props.get('door_count', 3)
        
        path = QPainterPath()
        
        # Draw each row as a rectangle with vertical dividers
        for row_idx in range(shelf_rows):
            top_y = row_idx * (shelf_height + row_gap)
            
            # Draw row outline
            path.addRect(0, top_y, columns * shelf_width, shelf_height)
            
            # Draw vertical dividers
            for col in range(1, columns):
                x_pos = col * shelf_width
                path.moveTo(x_pos, top_y)
                path.lineTo(x_pos, top_y + shelf_height)
        
        self.setPath(path)
    
    def boundingRect(self):
        """Return the bounding rectangle."""
        return self.path().boundingRect().adjusted(-10, -10, 10, 10)
    
    def itemChange(self, change, value):
        """Handle item changes."""
        if change == QGraphicsItem.GraphicsItemChange.ItemPositionChange:
            return snap_to_grid(value)
        if change == QGraphicsItem.GraphicsItemChange.ItemPositionHasChanged:
            self.data_manager.update_component_position(self.component_id, value)
            self.update_connected_pipes()

        if change == QGraphicsItem.GraphicsItemChange.ItemRotationHasChanged:
            self.component_data['rotation'] = value
            self.update_connected_pipes()

        return super().itemChange(change, value)
    
    def update_connected_pipes(self):
        """Update all pipes connected to this component's ports."""
        for port_item in self.ports.values():
            for pipe_item in port_item.connected_pipes:
                pipe_item.update_path()
    
    def mouseDoubleClickEvent(self, event):
        """Handle double-click to open property dialog."""
        if event.button() == Qt.MouseButton.LeftButton:
            if hasattr(self.scene(), 'views') and self.scene().views():
                view = self.scene().views()[0]
                if hasattr(view.parent(), 'on_component_double_clicked'):
                    view.parent().on_component_double_clicked(self)
        super().mouseDoubleClickEvent(event)


class SensorComponentItem(QGraphicsPathItem):
    """A dedicated sensor component drawn as a distinct dot on the line."""
    
    def __init__(self, component_id, component_data, data_manager):
        super().__init__()
        self.component_id = component_id
        self.component_data = component_data
        self.data_manager = data_manager
        self.schema = SCHEMAS.get(component_data['type'], {})
        
        # Initialize ports
        self.ports = {}
        
        # Visual setup - Distinct Blue Dot (User requested "slightly larger dot")
        # Standard port dot is usually small (~8px). Let's make this ~16-20px.
        self.setPen(QPen(QColor("#2980b9"), 2))  # Darker blue outline
        self.setBrush(QBrush(QColor("#3498db")))  # Bright blue fill
        
        # Interaction flags
        self.setFlag(QGraphicsItem.GraphicsItemFlag.ItemIsMovable, True)
        self.setFlag(QGraphicsItem.GraphicsItemFlag.ItemIsSelectable, True)
        self.setFlag(QGraphicsItem.GraphicsItemFlag.ItemSendsGeometryChanges, True)
        self.setCacheMode(QGraphicsItem.CacheMode.DeviceCoordinateCache)
        
        # Set position from data
        pos = component_data.get('position', [0, 0])
        if isinstance(pos, QPointF):
            self.setPos(pos)
        else:
            self.setPos(pos[0], pos[1])
        
        # Set rotation from data
        rotation = component_data.get('rotation', 0)
        self.setRotation(rotation)

        # Tooltip for measurement type
        self.update_tooltip()
        
        # Build the shape and ports
        self.update_shape()
        self.rebuild_ports()

    def update_tooltip(self):
        """Update tooltip based on current measurement type."""
        measure_type = self.component_data.get('properties', {}).get('measurement_type', 'Temperature')
        label = self.component_data.get('properties', {}).get('label', '')
        tooltip = f"<b>{measure_type} Sensor</b>"
        if label:
            tooltip += f"<br><i>{label}</i>"
        self.setToolTip(tooltip)
    
    def update_shape(self):
        """Draw a circle centered at (0,0)."""
        path = QPainterPath()
        radius = 10  # Diameter = 20px
        path.addEllipse(QPointF(0, 0), radius, radius)
        self.setPath(path)
    
    def rebuild_ports(self):
        """Create inlet (left) and outlet (right) ports to allow inline connection."""
        # IMPORTANT: Save pipe connections before clearing ports
        port_connections = {}
        for port_name, port_item in self.ports.items():
            if hasattr(port_item, 'connected_pipes') and port_item.connected_pipes:
                port_connections[port_name] = list(port_item.connected_pipes)
        
        # Clear existing ports
        for port_item in list(self.ports.values()):
            port_item.setParentItem(None)
            if port_item.scene():
                port_item.scene().removeItem(port_item)
        self.ports.clear()
        
        # Inlet on Left
        inlet_def = {'name': 'inlet', 'type': 'in', 'fluid_state': 'any', 'pressure_side': 'any', 'position': [0, 0.5]}
        inlet_port = PortItem('inlet', inlet_def, self)
        # Position at left edge of the circle (radius=10)
        inlet_port.setPos(-10, 0) 
        self.ports['inlet'] = inlet_port
        
        # Outlet on Right
        outlet_def = {'name': 'outlet', 'type': 'out', 'fluid_state': 'any', 'pressure_side': 'any', 'position': [1, 0.5]}
        outlet_port = PortItem('outlet', outlet_def, self)
        # Position at right edge of the circle
        outlet_port.setPos(10, 0)
        self.ports['outlet'] = outlet_port

        # Measurement port at Top (the data measurement point — green sensor dot)
        measurement_def = {'name': 'measurement', 'type': 'sensor', 'fluid_state': 'any', 'pressure_side': 'any', 'position': [0.5, 0]}
        measurement_port = PortItem('measurement', measurement_def, self)
        measurement_port.setPos(0, -10)  # Top of the 20px diameter circle
        self.ports['measurement'] = measurement_port

        # IMPORTANT: Restore pipe connections
        total_restored = 0
        comp_type = self.component_data['type']
        for port_name, pipes in port_connections.items():
            if port_name in self.ports:
                new_port = self.ports[port_name]
                for pipe in pipes:
                    if hasattr(new_port, 'add_connected_pipe'):
                        new_port.add_connected_pipe(pipe)
                    # Update pipe's internal port references
                    if hasattr(pipe, 'start_port_item') and hasattr(pipe, 'end_port_item'):
                        if hasattr(pipe, 'pipe_data') and hasattr(pipe, 'pipe_id'):
                            pipe_data = pipe.pipe_data
                            start_comp_id = pipe_data.get('start_component_id')
                            start_port = pipe_data.get('start_port')
                            end_comp_id = pipe_data.get('end_component_id')
                            end_port = pipe_data.get('end_port')
                            
                            if start_comp_id == self.component_id and start_port == port_name:
                                pipe.start_port_item = new_port
                            if end_comp_id == self.component_id and end_port == port_name:
                                pipe.end_port_item = new_port
                    if hasattr(pipe, 'update_path'):
                        pipe.update_path()
                    total_restored += 1

    def boundingRect(self):
        """Return the bounding rectangle."""
        return self.path().boundingRect().adjusted(-5, -5, 5, 5)
    
    def itemChange(self, change, value):
        """Handle item changes."""
        if change == QGraphicsItem.GraphicsItemChange.ItemPositionChange:
            return snap_to_grid(value)
        if change == QGraphicsItem.GraphicsItemChange.ItemPositionHasChanged:
            self.data_manager.update_component_position(self.component_id, value)
            self.update_connected_pipes()

        if change == QGraphicsItem.GraphicsItemChange.ItemRotationHasChanged:
            self.component_data['rotation'] = value
            self.update_connected_pipes()

        return super().itemChange(change, value)
    
    def update_connected_pipes(self):
        """Update all pipes connected to this component's ports."""
        for port_item in self.ports.values():
            for pipe_item in port_item.connected_pipes:
                pipe_item.update_path()
    
    def mouseDoubleClickEvent(self, event):
        """Handle double-click to open property dialog."""
        if event.button() == Qt.MouseButton.LeftButton:
            if hasattr(self.scene(), 'views') and self.scene().views():
                view = self.scene().views()[0]
                if hasattr(view.parent(), 'on_component_double_clicked'):
                    view.parent().on_component_double_clicked(self)
        super().mouseDoubleClickEvent(event)


class DraggableTextItem(QGraphicsTextItem):
    """A text item that can be dragged and maintains offset from parent sensor dot."""
    
    # Threshold distance for showing connection line (in pixels)
    CONNECTION_LINE_THRESHOLD = 35.0

    def __init__(self, text, parent, sensor_box, sensor_id, item_type):
        """
        Initialize draggable text item.

        Args:
            text: The text to display
            parent: The parent QGraphicsItem (can be None for diagram dots)
            sensor_box: The SensorBoxItem this belongs to (None for diagram dots)
            sensor_id: The sensor ID or role_key this text belongs to
            item_type: Type of item ('label', 'number', or 'value')
        """
        super().__init__(text, parent)
        self.sensor_box = sensor_box
        self.sensor_id = sensor_id
        self.item_type = item_type
        self.is_dragging = False
        self.drag_start_pos = None
        self.drag_start_scene_pos = None  # For movement threshold calculation
        self.role_key = None  # For diagram dots
        self.dot_item = None  # For diagram dots
        self.data_manager = None  # For diagram dots
        self.custom_click_handler = None  # For diagram dots - custom click handler
        self.custom_double_click_handler = None  # For diagram dots - custom double-click handler

        # Make the item movable ONLY if it's NOT part of a sensor box
        # For sensor boxes, only the entire box should be movable
        if sensor_box is None:
            # This is a diagram dot label - allow individual movement
            self.setFlag(QGraphicsItem.GraphicsItemFlag.ItemIsMovable, True)
            self.setFlag(QGraphicsItem.GraphicsItemFlag.ItemIsSelectable, True)
            self.setCursor(Qt.CursorShape.OpenHandCursor)
        else:
            # This is part of a sensor box - disable individual movement
            self.setFlag(QGraphicsItem.GraphicsItemFlag.ItemIsMovable, False)
            self.setFlag(QGraphicsItem.GraphicsItemFlag.ItemIsSelectable, False)
            self.setCursor(Qt.CursorShape.ArrowCursor)

    def paint(self, painter, option, widget=None):
        """Override paint to draw connection line when label is far from dot."""
        # Enable anti-aliasing for professional rendering
        painter.setRenderHint(QPainter.RenderHint.Antialiasing, True)
        painter.setRenderHint(QPainter.RenderHint.TextAntialiasing, True)
        painter.setRenderHint(QPainter.RenderHint.SmoothPixmapTransform, True)

        # Determine the dot item to connect to
        dot_item = None
        
        # For diagram dots, use dot_item directly
        if self.dot_item is not None:
            dot_item = self.dot_item
        # For sensor box items, get dot from sensor_box
        elif self.sensor_box is not None and self.sensor_id is not None:
            if self.sensor_id in self.sensor_box.sensors:
                sensor_info = self.sensor_box.sensors[self.sensor_id]
                dot_item = sensor_info.get('dot')
        
        # Draw connection line if we have a dot and label is beyond threshold distance
        # BUT: Skip drawing lines for sensor box items (user doesn't want this feature there)
        if dot_item is not None and self.sensor_box is None:
            # Get dot position in scene coordinates
            dot_scene_pos = dot_item.scenePos()

            # Get label center in local coordinates
            label_center = self.boundingRect().center()

            # Convert dot position to label's local coordinate system
            dot_local_pos = self.mapFromScene(dot_scene_pos)

            # Calculate distance between dot and label center
            dx = dot_local_pos.x() - label_center.x()
            dy = dot_local_pos.y() - label_center.y()
            distance = (dx * dx + dy * dy) ** 0.5

            # Draw line if distance exceeds threshold
            if distance > self.CONNECTION_LINE_THRESHOLD:
                # Save painter state
                painter.save()

                # Set subtle line style: light gray, thin, dashed
                pen = QPen(QColor('#CCCCCC'), 1, Qt.PenStyle.DashLine)
                painter.setPen(pen)

                # Draw line from dot to label center
                painter.drawLine(dot_local_pos, label_center)

                # Restore painter state
                painter.restore()
        
        # Call parent paint to draw the text
        super().paint(painter, option, widget)

    def mousePressEvent(self, event):
        """Handle mouse press - start dragging."""
        if event.button() == Qt.MouseButton.LeftButton:
            # DEBUG: Log initial state
            item_pos = self.pos()
            item_scene_pos = self.scenePos()
            event_pos = event.pos()
            event_scene_pos = event.scenePos()
            parent = self.parentItem()
            parent_type = type(parent).__name__ if parent else "None"
            is_movable = self.flags() & QGraphicsItem.GraphicsItemFlag.ItemIsMovable
            
            logger.info(f"[DRAG DEBUG] mousePressEvent - START")
            logger.info(f"  Item pos: ({item_pos.x():.1f}, {item_pos.y():.1f})")
            logger.info(f"  Item scenePos: ({item_scene_pos.x():.1f}, {item_scene_pos.y():.1f})")
            logger.info(f"  Event pos: ({event_pos.x():.1f}, {event_pos.y():.1f})")
            logger.info(f"  Event scenePos: ({event_scene_pos.x():.1f}, {event_scene_pos.y():.1f})")
            logger.info(f"  Parent: {parent_type}")
            logger.info(f"  ItemIsMovable flag: {bool(is_movable)}")
            logger.info(f"  sensor_box: {self.sensor_box is not None}")
            logger.info(f"  role_key: {self.role_key}")
            print(f"[DRAG DEBUG] mousePressEvent - START - role_key={self.role_key}, ItemIsMovable={bool(is_movable)}")
            
            self.is_dragging = True
            self.drag_start_pos = self.pos()  # Store item's position at drag start
            self.drag_start_scene_pos = event.scenePos()  # Store scene position for movement threshold
            self.setCursor(Qt.CursorShape.ClosedHandCursor)
            
            logger.info(f"  Set is_dragging=True, drag_start_pos=({self.drag_start_pos.x():.1f}, {self.drag_start_pos.y():.1f})")
            logger.info(f"  drag_start_scene_pos=({self.drag_start_scene_pos.x():.1f}, {self.drag_start_scene_pos.y():.1f})")
            print(f"[DRAG DEBUG] Set is_dragging=True, drag_start_pos=({self.drag_start_pos.x():.1f}, {self.drag_start_pos.y():.1f})")
            
            event.accept()
        else:
            super().mousePressEvent(event)

    def mouseMoveEvent(self, event):
        """Handle mouse move - update position while dragging."""
        if self.sensor_box is not None or not (self.flags() & QGraphicsItem.GraphicsItemFlag.ItemIsMovable):
            super().mouseMoveEvent(event)
            return

        if self.is_dragging:
            # DEBUG: Log movement state
            item_pos_before = self.pos()
            item_scene_pos_before = self.scenePos()
            event_scene_pos = event.scenePos()
            
            logger.info(f"[DRAG DEBUG] mouseMoveEvent - DRAGGING")
            logger.info(f"  Item pos BEFORE: ({item_pos_before.x():.1f}, {item_pos_before.y():.1f})")
            logger.info(f"  Item scenePos BEFORE: ({item_scene_pos_before.x():.1f}, {item_scene_pos_before.y():.1f})")
            logger.info(f"  Event scenePos: ({event_scene_pos.x():.1f}, {event_scene_pos.y():.1f})")
            print(f"[DRAG DEBUG] mouseMoveEvent - DRAGGING - Item pos BEFORE: ({item_pos_before.x():.1f}, {item_pos_before.y():.1f})")
            
            if self.drag_start_scene_pos is not None:
                delta = event_scene_pos - self.drag_start_scene_pos
                logger.info(f"  Delta from start: ({delta.x():.1f}, {delta.y():.1f})")
            
            # MANUALLY update position instead of relying on super()
            # Calculate the new position based on the mouse movement
            if self.drag_start_scene_pos is not None:
                # Calculate delta from drag start
                delta = event_scene_pos - self.drag_start_scene_pos
                # Get the item's position at drag start
                if self.drag_start_pos is not None:
                    new_pos = self.drag_start_pos + delta
                    self.setPos(new_pos)
                    logger.info(f"  MANUALLY set position to: ({new_pos.x():.1f}, {new_pos.y():.1f})")
                    print(f"[DRAG DEBUG] MANUALLY set position to: ({new_pos.x():.1f}, {new_pos.y():.1f})")
                else:
                    # Fallback: use super() if drag_start_pos not set
                    super().mouseMoveEvent(event)
            else:
                # Fallback: use super() if drag_start_scene_pos not set
                super().mouseMoveEvent(event)
            
            # DEBUG: Log position after update
            item_pos_after = self.pos()
            item_scene_pos_after = self.scenePos()
            logger.info(f"  Item pos AFTER: ({item_pos_after.x():.1f}, {item_pos_after.y():.1f})")
            logger.info(f"  Item scenePos AFTER: ({item_scene_pos_after.x():.1f}, {item_scene_pos_after.y():.1f})")
            
            if item_pos_before != item_pos_after:
                logger.info(f"  ✓ Position CHANGED")
                print(f"[DRAG DEBUG] ✓ Position CHANGED")
            else:
                logger.info(f"  ✗ Position NOT CHANGED")
                print(f"[DRAG DEBUG] ✗ Position NOT CHANGED")
            
            event.accept()
        else:
            super().mouseMoveEvent(event)
    
    def mouseDoubleClickEvent(self, event):
        """Handle double-click - call custom handler if exists."""
        if self.custom_double_click_handler is not None:
            try:
                self.custom_double_click_handler(event)
            except Exception as e:
                logger.error(f"[DRAGGABLE] Error calling custom double-click handler: {e}")
        else:
            super().mouseDoubleClickEvent(event)

    def mouseReleaseEvent(self, event):
        """Handle mouse release - finish dragging and save offset."""
        if self.sensor_box is not None or not (self.flags() & QGraphicsItem.GraphicsItemFlag.ItemIsMovable):
            super().mouseReleaseEvent(event)
            return

        if event.button() == Qt.MouseButton.LeftButton and self.is_dragging:
            # DEBUG: Log release state
            item_pos = self.pos()
            item_scene_pos = self.scenePos()
            event_scene_pos = event.scenePos()
            
            logger.info(f"[DRAG DEBUG] mouseReleaseEvent - RELEASE")
            logger.info(f"  Item pos: ({item_pos.x():.1f}, {item_pos.y():.1f})")
            logger.info(f"  Item scenePos: ({item_scene_pos.x():.1f}, {item_scene_pos.y():.1f})")
            logger.info(f"  Event scenePos: ({event_scene_pos.x():.1f}, {event_scene_pos.y():.1f})")
            
            # Calculate movement distance to distinguish click vs drag
            movement_threshold = 5.0  # pixels
            moved_distance = 0.0
            if self.drag_start_scene_pos is not None:
                moved_distance = ((event_scene_pos.x() - self.drag_start_scene_pos.x()) ** 2 + 
                                 (event_scene_pos.y() - self.drag_start_scene_pos.y()) ** 2) ** 0.5
                logger.info(f"  Movement distance: {moved_distance:.1f} pixels (threshold: {movement_threshold})")
                logger.info(f"  Start scenePos: ({self.drag_start_scene_pos.x():.1f}, {self.drag_start_scene_pos.y():.1f})")
                logger.info(f"  End scenePos: ({event_scene_pos.x():.1f}, {event_scene_pos.y():.1f})")
            
            pos_change = item_pos - self.drag_start_pos if self.drag_start_pos is not None else None
            if pos_change:
                logger.info(f"  Position change from start: ({pos_change.x():.1f}, {pos_change.y():.1f})")
            
            self.is_dragging = False
            self.setCursor(Qt.CursorShape.OpenHandCursor if self.flags() & QGraphicsItem.GraphicsItemFlag.ItemIsMovable else Qt.CursorShape.ArrowCursor)
            
            logger.info(f"  Set is_dragging=False")

            # If movement was small (click, not drag), call custom click handler if exists
            if moved_distance <= movement_threshold and self.custom_click_handler is not None:
                # Call the handler with the release event (handler will treat it as a click)
                try:
                    self.custom_click_handler(event)
                except Exception as e:
                    logger.error(f"[DRAGGABLE] Error calling custom click handler: {e}")
            
            # Only save position if actually dragged (moved more than threshold)
            if moved_distance > movement_threshold:
                if self.sensor_box is not None:
                    # Sensor box item - use existing logic
                    if self.sensor_id in self.sensor_box.sensors:
                        sensor_info = self.sensor_box.sensors[self.sensor_id]
                        dot = sensor_info.get('dot')
                        if dot:
                            # Get current position relative to parent (the sensor box)
                            current_pos = self.pos()
                            dot_pos = dot.pos()

                            # Calculate offset from dot
                            dx = current_pos.x() - dot_pos.x()
                            dy = current_pos.y() - dot_pos.y()

                            # Save the offset
                            self.sensor_box.save_label_offset(self.sensor_id, self.item_type, dx, dy)
                else:
                    # Diagram dot item - save to diagram_model
                    if self.dot_item is not None and self.role_key is not None and self.data_manager is not None:
                        # Get current position in scene coordinates
                        current_scene_pos = self.scenePos()
                        dot_scene_pos = self.dot_item.scenePos()
                        
                        # Calculate offset from dot
                        dx = current_scene_pos.x() - dot_scene_pos.x()
                        dy = current_scene_pos.y() - dot_scene_pos.y()
                        
                        # Save to diagram_model
                        if 'role_dot_labels' not in self.data_manager.diagram_model:
                            self.data_manager.diagram_model['role_dot_labels'] = {}
                        
                        self.data_manager.diagram_model['role_dot_labels'][self.role_key] = {'dx': dx, 'dy': dy}
                        # Emit signal to notify that diagram model changed (will be saved when user saves session)
                        self.data_manager.diagram_model_changed.emit()

            event.accept()
        else:
            super().mouseReleaseEvent(event)


class RemoteLineEndpointItem(QGraphicsRectItem):
    """A remote line endpoint stub — dashed-border rectangle with a centred label.

    Used for Remote-case diagrams where the compressor and condenser are located
    remotely. Two instances are placed:
      • label = "Liquid Line In"   — entry point for high-pressure liquid
      • label = "Suction Line Out" — exit point for low-pressure gas

    Visual: dashed outline, transparent fill, label centred inside.
    Port:   single 'connection' port at the component centre [0.5, 0.5].
    """

    DEFAULT_WIDTH  = 140
    DEFAULT_HEIGHT = 60

    def __init__(self, component_id, component_data, data_manager):
        size = component_data.get('size', {'width': self.DEFAULT_WIDTH, 'height': self.DEFAULT_HEIGHT})
        w = size.get('width', self.DEFAULT_WIDTH)
        h = size.get('height', self.DEFAULT_HEIGHT)
        super().__init__(0, 0, w, h)

        self.component_id  = component_id
        self.component_data = component_data
        self.data_manager  = data_manager
        self.schema        = SCHEMAS.get(component_data['type'], {})
        self.ports         = {}
        self.sensor_box    = None

        # --- Visual: dashed border, transparent fill -----------------------
        dash_pen = QPen(QColor("#555555"), 2, Qt.PenStyle.DashLine)
        self.setPen(dash_pen)
        self.setBrush(QBrush(Qt.GlobalColor.transparent))

        # --- Centred label -------------------------------------------------
        label_text = component_data.get('properties', {}).get('label', 'Remote Connection')
        self.label = QGraphicsTextItem(label_text, self)
        self.label.setDefaultTextColor(QColor("#333333"))
        # Centre the label text within the rectangle
        self._center_label()

        # --- Interaction flags ---------------------------------------------
        self.setFlag(QGraphicsItem.GraphicsItemFlag.ItemIsMovable, True)
        self.setFlag(QGraphicsItem.GraphicsItemFlag.ItemIsSelectable, True)
        self.setFlag(QGraphicsItem.GraphicsItemFlag.ItemSendsGeometryChanges, True)
        self.setCacheMode(QGraphicsItem.CacheMode.DeviceCoordinateCache)

        # --- Position / rotation from model --------------------------------
        pos = component_data.get('position', [0, 0])
        if isinstance(pos, QPointF):
            self.setPos(pos)
        else:
            self.setPos(pos[0], pos[1])
        self.setRotation(component_data.get('rotation', 0))

        # --- Build the single connection port ------------------------------
        self.rebuild_ports()

    # ------------------------------------------------------------------
    def _center_label(self):
        """Re-centre the label text inside the rectangle."""
        rect = self.rect()
        br   = self.label.boundingRect()
        lx   = (rect.width()  - br.width())  / 2.0
        ly   = (rect.height() - br.height()) / 2.0
        self.label.setPos(lx, ly)

    # ------------------------------------------------------------------
    def rebuild_ports(self):
        """Create (or recreate) the single 'connection' port at the centre."""
        # Save and restore pipe connections across rebuild
        port_connections = {}
        for pname, pitem in self.ports.items():
            if hasattr(pitem, 'connected_pipes') and pitem.connected_pipes:
                port_connections[pname] = list(pitem.connected_pipes)

        # Remove old ports from scene / parent
        for pitem in list(self.ports.values()):
            pitem.setParentItem(None)
            if pitem.scene():
                pitem.scene().removeItem(pitem)
        self.ports.clear()

        # Single centre port
        rect = self.rect()
        cx   = rect.width()  / 2.0
        cy   = rect.height() / 2.0

        conn_def = {
            'name':          'connection',
            'type':          'in',
            'fluid_state':   'any',
            'pressure_side': 'any',
            'position':      [0.5, 0.5],
        }
        conn_port = PortItem('connection', conn_def, self)
        conn_port.setPos(cx, cy)
        self.ports['connection'] = conn_port

        # Restore pipe connections
        for pname, pipes in port_connections.items():
            if pname in self.ports:
                new_port = self.ports[pname]
                for pipe in pipes:
                    if hasattr(new_port, 'add_connected_pipe'):
                        new_port.add_connected_pipe(pipe)
                    if hasattr(pipe, 'pipe_data'):
                        pd = pipe.pipe_data
                        if pd.get('start_component_id') == self.component_id and pd.get('start_port') == pname:
                            pipe.start_port_item = new_port
                        if pd.get('end_component_id') == self.component_id and pd.get('end_port') == pname:
                            pipe.end_port_item = new_port
                    if hasattr(pipe, 'update_path'):
                        pipe.update_path()

    # ------------------------------------------------------------------
    def itemChange(self, change, value):
        if change == QGraphicsItem.GraphicsItemChange.ItemPositionChange:
            return snap_to_grid(value)
        if change == QGraphicsItem.GraphicsItemChange.ItemPositionHasChanged:
            self.data_manager.update_component_position(self.component_id, value)
            self._update_connected_pipes()
        if change == QGraphicsItem.GraphicsItemChange.ItemRotationHasChanged:
            self.component_data['rotation'] = value
            self._update_connected_pipes()
        return super().itemChange(change, value)

    def _update_connected_pipes(self):
        for pitem in self.ports.values():
            for pipe in pitem.connected_pipes:
                pipe.update_path()

    # ------------------------------------------------------------------
    def mouseDoubleClickEvent(self, event):
        """Open property dialog on double-click (to edit the label text)."""
        if event.button() == Qt.MouseButton.LeftButton:
            if hasattr(self.scene(), 'views') and self.scene().views():
                view = self.scene().views()[0]
                if hasattr(view.parent(), 'on_component_double_clicked'):
                    view.parent().on_component_double_clicked(self)
        super().mouseDoubleClickEvent(event)

    # ------------------------------------------------------------------
    def update_label_from_properties(self):
        """Refresh displayed label text after property dialog saves changes."""
        label_text = self.component_data.get('properties', {}).get('label', 'Remote Connection')
        self.label.setPlainText(label_text)
        self._center_label()


class SensorBoxItem(QGraphicsRectItem):
    """A movable sensor box with three-column layout: Dot+Label | Number | Value."""
    
    # Layout constants
    COL1_WIDTH = 150  # Dot + label column
    COL2_X = 160      # Number column X position
    COL3_X = 220      # Value column X position
    BOX_WIDTH = 350   # Total box width
    ROW_HEIGHT = 30   # Height per sensor row
    TITLE_HEIGHT = 40 # Height for title bar
    BOTTOM_PADDING = 10  # Bottom padding
    
    def __init__(self, box_id, box_data, data_manager):
        # Calculate height based on number of sensors
        num_sensors = len(box_data.get('sensors', []))
        height = self.TITLE_HEIGHT + 10 + (num_sensors * self.ROW_HEIGHT) + self.BOTTOM_PADDING
        
        super().__init__(0, 0, self.BOX_WIDTH, height)
        
        self.box_id = box_id
        self.box_data = box_data
        self.data_manager = data_manager
        self.sensors = {}  # sensor_id -> {'label': str, 'role_key': str, 'dot': ..., 'label_item': ..., 'number_item': ..., 'value_item': ...}
        
        # Transparent background - no visible box
        self.setBrush(QBrush(Qt.GlobalColor.transparent))  # No background
        self.setPen(QPen(Qt.GlobalColor.transparent))      # No border
        
        from PyQt6.QtGui import QFont
        self.font = QFont('Arial', 9)
        font = self.font
        
        # Create title label
        self.title = box_data.get('title', 'Sensor Box')
        self.title_item = QGraphicsTextItem(self.title, self)
        self.title_item.setFont(QFont('Arial', 10, QFont.Weight.Bold))
        self.title_item.setDefaultTextColor(QColor("#000000"))
        self.title_item.setPos(10, 5)
        
        # Create column headers
        self.header_label = QGraphicsTextItem("Sensor Label", self)
        self.header_label.setFont(font)
        self.header_label.setDefaultTextColor(QColor("#000000"))
        self.header_label.setPos(10, 25)
        
        self.header_number = QGraphicsTextItem("#", self)
        self.header_number.setFont(font)
        self.header_number.setDefaultTextColor(QColor("#000000"))
        self.header_number.setPos(self.COL2_X, 25)
        
        self.header_value = QGraphicsTextItem("sensor value", self)
        self.header_value.setFont(font)
        self.header_value.setDefaultTextColor(QColor("#000000"))
        self.header_value.setPos(self.COL3_X, 25)
        
        # Interaction flags
        self.setFlag(QGraphicsItem.GraphicsItemFlag.ItemIsMovable, True)
        self.setFlag(QGraphicsItem.GraphicsItemFlag.ItemIsSelectable, True)
        self.setFlag(QGraphicsItem.GraphicsItemFlag.ItemSendsGeometryChanges, True)
        self.setCacheMode(QGraphicsItem.CacheMode.DeviceCoordinateCache)
        
        # Set position from data
        pos = box_data.get('position', [0, 0])
        if isinstance(pos, QPointF):
            self.setPos(pos)
        else:
            self.setPos(pos[0], pos[1])
        
        # Build sensors
        self.rebuild_sensors()
    
    def rebuild_sensors(self):
        """Rebuild all sensor rows with three-column layout."""
        # Clear existing sensor items
        for sensor_id, sensor_info in list(self.sensors.items()):
            for key in ['dot', 'label_item', 'number_item', 'value_item']:
                if sensor_info.get(key):
                    if sensor_info[key].scene():
                        self.scene().removeItem(sensor_info[key])
        
        # Initialize sensors from box_data
        sensors_data = self.box_data.get('sensors', [])
        self.sensors = {}
        
        # Create sensor rows (start after title + header)
        for idx, sensor in enumerate(sensors_data):
            sensor_id = sensor['id']
            label = sensor.get('label', f'Sensor {sensor_id[:6]}')
            role_key = f"sensorbox.{self.box_id}.{sensor_id}"
            
            # Calculate Y position for this row (after title + header + spacing)
            y = self.TITLE_HEIGHT + 10 + (idx * self.ROW_HEIGHT)
            
            # Create sensor row
            self.create_sensor_row(10, y, sensor_id, {'label': label, 'role_key': role_key})
    
    def create_sensor_row(self, x, y, sensor_id, sensor_info):
        """Create one sensor's row with three columns: dot+label | number | value."""
        role_key = sensor_info['role_key']

        # Check if mapped
        mapped_sensor = self.data_manager.get_mapped_sensor_for_role(role_key) if self.data_manager else None
        is_selected = mapped_sensor and mapped_sensor in self.data_manager.selected_sensors if self.data_manager else False

        # Create dot (square for sensor box)
        if is_selected:
            dot_color = QColor('#00D4FF')  # Bright cyan - selected (distinct from out-of-range red)
            pen_width = 4
        elif mapped_sensor:
            dot_color = QColor('#4CAF50')  # Green for mapped
            pen_width = 2
        else:
            dot_color = QColor('#FF6B00')  # Orange for unmapped
            pen_width = 2

        dot = QGraphicsRectItem(-6, -6, 12, 12, self)
        dot.setBrush(QBrush(dot_color))
        dot.setPen(QPen(Qt.GlobalColor.black, pen_width))
        dot.setPos(x, y)
        if is_selected:
            dot.setScale(2.8)  # Huge when selected - impossible to miss
        dot.setZValue(100)
        dot.setCursor(Qt.CursorShape.PointingHandCursor)
        dot.setData(0, role_key)
        dot.setData(1, 'sensor_box')
        dot.setData(2, sensor_id)
        sensor_info['dot'] = dot

        # Load stored offsets from box_data
        stored_offsets = {}
        if 'sensors' in self.box_data:
            for sensor in self.box_data['sensors']:
                if sensor['id'] == sensor_id:
                    stored_offsets = sensor.get('offsets', {})
                    break

        # Default offsets if not stored
        default_label_offset = {'dx': 15, 'dy': -8}
        default_number_offset = {'dx': self.COL2_X - x, 'dy': -8}
        default_value_offset = {'dx': self.COL3_X - x, 'dy': -8}

        # Get offsets (use stored or default)
        label_offset = stored_offsets.get('label', default_label_offset)
        number_offset = stored_offsets.get('number', default_number_offset)
        value_offset = stored_offsets.get('value', default_value_offset)

        # Create label item (right of dot in column 1) - now draggable
        label_text = sensor_info['label']
        label_item = DraggableTextItem(label_text, self, self, sensor_id, 'label')
        label_item.setFont(self.font)
        label_item.setDefaultTextColor(QColor("#000000"))
        label_item.setPos(x + label_offset['dx'], y + label_offset['dy'])
        sensor_info['label_item'] = label_item

        # Create number item (column 2) - now draggable
        number_text = ""
        if mapped_sensor:
            num = self.data_manager.get_sensor_number(mapped_sensor)
            number_text = f"#{num}" if num is not None else ""
        number_item = DraggableTextItem(number_text, self, self, sensor_id, 'number')
        number_item.setFont(self.font)
        number_item.setDefaultTextColor(QColor("#000000"))
        number_item.setPos(x + number_offset['dx'], y + number_offset['dy'])
        sensor_info['number_item'] = number_item

        # Create value item (column 3) - now draggable
        value_text = ""
        if mapped_sensor:
            val = self.data_manager.get_sensor_value(mapped_sensor)
            if val is None:
                value_text = ""
            elif isinstance(val, (int, float)):
                value_text = f"{val:.1f}"
            else:
                value_text = str(val)
        value_item = DraggableTextItem(value_text, self, self, sensor_id, 'value')
        value_item.setFont(self.font)
        value_item.setDefaultTextColor(QColor("#000000"))
        value_item.setPos(x + value_offset['dx'], y + value_offset['dy'])
        sensor_info['value_item'] = value_item

        # Store in sensors dict
        self.sensors[sensor_id] = sensor_info
    
    def add_sensor(self, label):
        """Add a new sensor to the box."""
        import uuid
        sensor_id = f"sensor_{uuid.uuid4().hex[:8]}"
        role_key = f"sensorbox.{self.box_id}.{sensor_id}"
        
        sensor_info = {'label': label, 'role_key': role_key, 'dot': None, 'label_item': None, 'number_item': None, 'value_item': None}
        
        # Update box_data
        if 'sensors' not in self.box_data:
            self.box_data['sensors'] = []
        self.box_data['sensors'].append({'id': sensor_id, 'label': label})
        
        # Rebuild sensors to show new one
        self.rebuild_sensors()
        
        # Adjust box height
        self.adjust_height()
        
        return sensor_id
    
    def remove_sensor(self, sensor_id):
        """Remove a sensor from the box."""
        # Remove from box_data
        if 'sensors' in self.box_data:
            self.box_data['sensors'] = [s for s in self.box_data['sensors'] if s['id'] != sensor_id]
        
        # Unmap role if exists
        if self.data_manager:
            self.data_manager.unmap_role(f"sensorbox.{self.box_id}.{sensor_id}")
        
        # Rebuild sensors to update layout
        self.rebuild_sensors()
        
        # Adjust box height
        self.adjust_height()
    
    def adjust_height(self):
        """Adjust box height to fit all sensors."""
        num_sensors = len(self.sensors)
        height = self.TITLE_HEIGHT + 10 + (num_sensors * self.ROW_HEIGHT) + self.BOTTOM_PADDING
        
        # Update rect
        current_rect = self.rect()
        new_rect = QRectF(0, 0, current_rect.width(), height)
        self.setRect(new_rect)
    
    def edit_title(self, new_title):
        """Update the box title."""
        self.title = new_title
        self.title_item.setPlainText(new_title)
        self.box_data['title'] = new_title

    def save_label_offset(self, sensor_id, item_type, dx, dy):
        """
        Save the offset for a label relative to its dot.

        Args:
            sensor_id: The sensor ID
            item_type: Type of item ('label', 'number', or 'value')
            dx: X offset from dot
            dy: Y offset from dot
        """
        # Find the sensor in box_data
        if 'sensors' in self.box_data:
            for sensor in self.box_data['sensors']:
                if sensor['id'] == sensor_id:
                    # Initialize offsets dict if it doesn't exist
                    if 'offsets' not in sensor:
                        sensor['offsets'] = {}

                    # Store the offset
                    sensor['offsets'][item_type] = {'dx': dx, 'dy': dy}

                    # Update in data manager if available
                    if self.data_manager:
                        # Emit signal to notify that diagram model changed (will be saved when user saves session)
                        self.data_manager.diagram_model_changed.emit()

                    break

    def itemChange(self, change, value):
        """Handle item changes."""
        if change == QGraphicsItem.GraphicsItemChange.ItemPositionChange:
            return snap_to_grid(value)
        if change == QGraphicsItem.GraphicsItemChange.ItemPositionHasChanged:
            if self.data_manager:
                # Update position in model
                self.data_manager.update_sensor_box_position(self.box_id, value)

        return super().itemChange(change, value)

    def mouseDoubleClickEvent(self, event):
        """Handle double-click to edit title."""
        if event.button() == Qt.MouseButton.LeftButton:
            if hasattr(self.scene(), 'views') and self.scene().views():
                view = self.scene().views()[0]
                if hasattr(view.parent(), 'on_sensor_box_double_clicked'):
                    view.parent().on_sensor_box_double_clicked(self)
        super().mouseDoubleClickEvent(event)
    
    def contextMenuEvent(self, event):
        """Handle right-click context menu."""
        from PyQt6.QtWidgets import QMenu
        
        menu = QMenu()
        
        # Add Sensor action
        add_action = menu.addAction("Add Sensor")
        add_action.triggered.connect(self._add_sensor)
        
        menu.addSeparator()
        
        # Edit Title action
        edit_title_action = menu.addAction("Edit Header")
        edit_title_action.triggered.connect(self._edit_title)
        
        menu.addSeparator()
        
        # Delete Box action
        delete_action = menu.addAction("Delete Box")
        delete_action.triggered.connect(self._delete_box)
        
        menu.exec(event.screenPos())
        event.accept()
    
    def _add_sensor(self):
        """Add a new sensor to the box."""
        if hasattr(self.scene(), 'views') and self.scene().views():
            view = self.scene().views()[0]
            if hasattr(view.parent(), 'on_add_sensor_to_box'):
                view.parent().on_add_sensor_to_box(self)
    
    def _edit_title(self):
        """Edit the box title."""
        if hasattr(self.scene(), 'views') and self.scene().views():
            view = self.scene().views()[0]
            if hasattr(view.parent(), 'on_edit_box_title'):
                view.parent().on_edit_box_title(self)
    
    def _delete_box(self):
        """Delete the box."""
        if hasattr(self.scene(), 'views') and self.scene().views():
            view = self.scene().views()[0]
            if hasattr(view.parent(), 'on_delete_sensor_box'):
                view.parent().on_delete_sensor_box(self)


class PipeItem(QGraphicsPathItem):
    """A connection between two ports with editable waypoints."""
    
    def __init__(self, pipe_id, pipe_data, start_port_item, end_port_item):
        super().__init__()
        self.pipe_id = pipe_id
        self.pipe_data = pipe_data
        self.start_port_item = start_port_item
        self.end_port_item = end_port_item
        
        # Track this pipe in the ports
        start_port_item.add_connected_pipe(self)
        end_port_item.add_connected_pipe(self)
        
        # Visual setup
        pen = self._get_pen_style()
        self.setPen(pen)

        _simple = pipe_data.get('_simple_mode', False)
        self.setFlag(QGraphicsItem.GraphicsItemFlag.ItemIsSelectable, not _simple)
        if _simple:
            self.setAcceptedMouseButtons(Qt.MouseButton.NoButton)
        else:
            self.setAcceptedMouseButtons(Qt.MouseButton.LeftButton | Qt.MouseButton.RightButton)
            self.setAcceptHoverEvents(True)
            self.setCursor(Qt.CursorShape.OpenHandCursor)
        self.setZValue(1)
        # IMPROVED: Better rendering for smoother lines
        self.setCacheMode(QGraphicsItem.CacheMode.DeviceCoordinateCache)
        
        # Rich tooltip with pipe diagnostics
        try:
            tooltip = (
                f"Pipe ID: {pipe_id}\n"
                f"Fluid: {pipe_data.get('fluid_state', 'unknown')}\n"
                f"Pressure: {pipe_data.get('pressure_side', 'any')}\n"
                f"Circuit: {pipe_data.get('circuit_label', 'None')}\n"
                f"From: {pipe_data.get('start_component_id')}.{pipe_data.get('start_port')}\n"
                f"To:   {pipe_data.get('end_component_id')}.{pipe_data.get('end_port')}\n\n"
                f"Drag a segment sideways to reroute\nDelete: remove pipe"
            )
        except Exception:
            tooltip = (
                f"Pipe: {pipe_data.get('fluid_state', 'unknown')}\n"
                f"Drag a segment sideways to reroute\n"
                f"Delete key to remove pipe"
            )
        self.setToolTip(tooltip)

        # Segment-dragging state
        self._is_dragging = False
        self._drag_seg = None        # index of the segment being dragged
        self._drag_vertical = False  # orientation of the dragged segment
        self._press_scene_pos = None

        # Store original pen for selection highlighting
        self._original_pen = pen

        self.update_path()
    
    def _get_pen_style(self):
        """Return pen based on pressure side - only two colors."""
        if self.pipe_data.get('_simple_mode'):
            return QPen(QColor("#888888"), 2)

        pressure_side = self.pipe_data.get('pressure_side', 'any')

        # Red for high pressure, Blue for low pressure
        if pressure_side == 'high':
            return QPen(QColor("#FF5722"), 4)  # Red for high pressure
        elif pressure_side == 'low':
            return QPen(QColor("#2196F3"), 4)  # Blue for low pressure
        else:
            return QPen(QColor("#4CAF50"), 4)  # Green for unspecified (junctions, etc.)

    def _get_port_exit_vector(self, port_item):
        """Get the perpendicular exit vector for a port, accounting for component rotation."""
        # Get port position relative to parent component (0-1 normalized)
        port_def = port_item.port_def
        port_pos = port_def.get('position', [0.5, 0.5])
        x, y = port_pos
        
        # Determine the normal (perpendicular) direction based on which edge
        # These are in component's local coordinate system
        if x <= 0.05:  # Left edge
            normal = QPointF(-1, 0)  # Points left
        elif x >= 0.95:  # Right edge
            normal = QPointF(1, 0)   # Points right
        elif y <= 0.05:  # Top edge
            normal = QPointF(0, -1)  # Points up
        elif y >= 0.95:  # Bottom edge
            normal = QPointF(0, 1)   # Points down
        else:
            # Default to horizontal if unclear
            normal = QPointF(1, 0) if x > 0.5 else QPointF(-1, 0)
        
        # Apply the component's rotation to the normal vector
        component = port_item.parent_component
        rotation_deg = component.rotation()

        # Use QTransform for proper rotation
        transform = QTransform()
        transform.rotate(rotation_deg)
        rotated_normal = transform.map(normal)
        
        return rotated_normal
    
    # ------------------------------------------------------------------
    #  Route engine (CAD-style)
    #
    #  The pipe's geometry is an explicit vertex chain pipe_data['route'] =
    #  [[x, y], ...] running from start port to end port.  Invariants:
    #    * every segment is exactly horizontal or vertical (perpendicular
    #      constraint, permanently on — slants are structurally impossible)
    #    * the first/last vertex always coincide with the ports (components
    #      are the grounded geometry)
    #  Rendering just draws the chain — no routing heuristics at paint time.
    #  Auto-routing runs once to seed a new (or legacy) pipe, never again.
    # ------------------------------------------------------------------

    EPS = 0.01           # coordinate equality tolerance
    JOG_THRESHOLD = 15   # straighten: jogs shorter than this are flattened

    def _port_anchor(self, port_item):
        p = port_item.get_scene_position()
        return [p.x(), p.y()]

    def _seed_route(self):
        """Build the initial vertex chain: from legacy waypoints if present
        (preserving the exact shape the old renderer drew), else a simple
        one-time auto-route."""
        start = self._port_anchor(self.start_port_item)
        end = self._port_anchor(self.end_port_item)
        sv = self._get_port_exit_vector(self.start_port_item)
        ev = self._get_port_exit_vector(self.end_port_item)
        off = 30
        s_off = [start[0] + sv.x() * off, start[1] + sv.y() * off]
        e_off = [end[0] + ev.x() * off, end[1] + ev.y() * off]

        wps = self.pipe_data.get('waypoints') or []
        pts = [start, s_off]
        if wps:
            cur = s_off
            for wp in wps:
                pts.append([wp[0], cur[1]])
                pts.append([wp[0], wp[1]])
                cur = [wp[0], wp[1]]
            pts.append([e_off[0], cur[1]])
        else:
            if abs(sv.x()) > abs(sv.y()):
                mid_x = (s_off[0] + e_off[0]) / 2
                pts.append([mid_x, s_off[1]])
                pts.append([mid_x, e_off[1]])
            else:
                mid_y = (s_off[1] + e_off[1]) / 2
                pts.append([s_off[0], mid_y])
                pts.append([e_off[0], mid_y])
        pts.append(e_off)
        pts.append(end)
        return pts

    def _sanitize_route(self, pts):
        """Enforce invariants: drop zero-length segments, insert a corner
        for any diagonal pair, merge collinear neighbors."""
        out = [list(pts[0])]
        for p in pts[1:]:
            q = out[-1]
            dx, dy = p[0] - q[0], p[1] - q[1]
            if abs(dx) < self.EPS and abs(dy) < self.EPS:
                continue
            if abs(dx) > self.EPS and abs(dy) > self.EPS:
                out.append([p[0], q[1]])  # corner (horizontal first)
            out.append(list(p))
        merged = [out[0]]
        for p in out[1:]:
            if len(merged) >= 2:
                a, b = merged[-2], merged[-1]
                if ((abs(a[0] - b[0]) < self.EPS and abs(b[0] - p[0]) < self.EPS)
                        or (abs(a[1] - b[1]) < self.EPS and abs(b[1] - p[1]) < self.EPS)):
                    merged[-1] = list(p)
                    continue
            merged.append(list(p))
        return merged

    def _pin_end(self, pts, start):
        """Pin one route end to its port, stretching only the adjacent
        segment so the rest of the user's routing stays put."""
        anchor = self._port_anchor(self.start_port_item if start else self.end_port_item)
        i0, i1 = (0, 1) if start else (len(pts) - 1, len(pts) - 2)
        v0, v1 = pts[i0], pts[i1]
        if abs(anchor[0] - v0[0]) < self.EPS and abs(anchor[1] - v0[1]) < self.EPS:
            return
        if abs(v1[0] - v0[0]) < self.EPS:   # adjacent segment is vertical
            v1[0] = anchor[0]               # keep it vertical
        else:                               # horizontal
            v1[1] = anchor[1]
        v0[0], v0[1] = anchor[0], anchor[1]

    def _current_route(self):
        """Return the sanitized, port-pinned route, persisting it in the model."""
        pts = self.pipe_data.get('route')
        if not pts or len(pts) < 2:
            pts = self._seed_route()
        pts = self._sanitize_route([list(p) for p in pts])

        s = self._port_anchor(self.start_port_item)
        e = self._port_anchor(self.end_port_item)
        if len(pts) == 2:
            # Straight pipe: stays straight if ports are still collinear,
            # otherwise grow a centered jog
            if abs(s[0] - e[0]) < self.EPS or abs(s[1] - e[1]) < self.EPS:
                pts = [s, e]
            elif abs(pts[0][0] - pts[1][0]) < self.EPS:   # was vertical
                mid_y = (s[1] + e[1]) / 2
                pts = [s, [s[0], mid_y], [e[0], mid_y], e]
            else:
                mid_x = (s[0] + e[0]) / 2
                pts = [s, [mid_x, s[1]], [mid_x, e[1]], e]
        else:
            self._pin_end(pts, start=True)
            self._pin_end(pts, start=False)
            pts = self._sanitize_route(pts)

        self.pipe_data['route'] = pts
        self.pipe_data.pop('waypoints', None)  # legacy data consumed
        return pts

    def _set_path_from(self, pts):
        """Draw the chain, trimming the ends slightly at Junction ports so
        the pipe stops at the junction boundary."""
        draw = [QPointF(p[0], p[1]) for p in pts]
        port_inset = 6
        for is_start in (True, False):
            port = self.start_port_item if is_start else self.end_port_item
            comp = getattr(port, 'parent_component', None)
            if not (comp and (comp.component_data or {}).get('type') == 'Junction'):
                continue
            a, b = (draw[0], draw[1]) if is_start else (draw[-1], draw[-2])
            seg = QPointF(b.x() - a.x(), b.y() - a.y())
            length = abs(seg.x()) + abs(seg.y())
            if length > port_inset:
                f = port_inset / length
                moved = QPointF(a.x() + seg.x() * f, a.y() + seg.y() * f)
                if is_start:
                    draw[0] = moved
                else:
                    draw[-1] = moved
        path = QPainterPath()
        path.moveTo(draw[0])
        for p in draw[1:]:
            path.lineTo(p)
        self.setPath(path)

    def update_path(self):
        """Re-pin the route to the ports and redraw it."""
        self._set_path_from(self._current_route())

    def shape(self):
        """Widen the interactive shape so drags/clicks are easy to hit."""
        base_path = super().shape() if not self.path().isEmpty() else QPainterPath()
        if not self.path().isEmpty():
            stroker = QPainterPathStroker()
            stroker.setWidth(12)  # generous hit area
            return stroker.createStroke(self.path())
        return base_path

    def hoverEnterEvent(self, event):
        """Highlight pipe on hover."""
        pen = self.pen()
        # IMPROVED: More visible hover effect
        pen.setWidth(6)
        self.setPen(pen)
        super().hoverEnterEvent(event)
    
    def hoverLeaveEvent(self, event):
        """Remove highlight."""
        # Only restore if not selected
        if not self.isSelected():
            pen = self.pen()
            # IMPROVED: Match new thicker default
            pen.setWidth(4)
            self.setPen(pen)
        super().hoverLeaveEvent(event)
    
    def itemChange(self, change, value):
        """Handle selection changes."""
        if change == QGraphicsItem.GraphicsItemChange.ItemPositionChange:
            return snap_to_grid(value)
        if change == QGraphicsItem.GraphicsItemChange.ItemSelectedChange:
            if value:  # Selected
                # Highlight with yellow border
                pen = self.pen()
                pen.setWidth(6)
                pen.setColor(QColor("#FFD700"))  # Gold color for selection
                self.setPen(pen)
                # Detailed console dump for diagnostics
                try:
                    start = self.start_port_item
                    end = self.end_port_item
                    sp = start.parent_component.component_data if hasattr(start, 'parent_component') else {}
                    ep = end.parent_component.component_data if hasattr(end, 'parent_component') else {}
                    print("[PIPE DEBUG] ========= Selected Pipe =========")
                    print(f"[PIPE DEBUG] pipe_id            : {self.pipe_id}")
                    print(f"[PIPE DEBUG] fluid_state        : {self.pipe_data.get('fluid_state')}")
                    print(f"[PIPE DEBUG] pressure_side      : {self.pipe_data.get('pressure_side')}")
                    print(f"[PIPE DEBUG] circuit_label      : {self.pipe_data.get('circuit_label')}")
                    print(f"[PIPE DEBUG] route              : {self.pipe_data.get('route')}")
                    print(f"[PIPE DEBUG] start_component_id : {self.pipe_data.get('start_component_id')}")
                    print(f"[PIPE DEBUG] start_port         : {self.pipe_data.get('start_port')}")
                    print(f"[PIPE DEBUG] end_component_id   : {self.pipe_data.get('end_component_id')}")
                    print(f"[PIPE DEBUG] end_port           : {self.pipe_data.get('end_port')}")
                    # Start component details
                    print(f"[PIPE DEBUG] -- START COMPONENT --")
                    print(f"[PIPE DEBUG] type               : {sp.get('type')}")
                    print(f"[PIPE DEBUG] properties         : {sp.get('properties')}")
                    print(f"[PIPE DEBUG] rotation           : {sp.get('rotation')}")
                    print(f"[PIPE DEBUG] position           : {sp.get('position')}")
                    # End component details
                    print(f"[PIPE DEBUG] -- END COMPONENT --")
                    print(f"[PIPE DEBUG] type               : {ep.get('type')}")
                    print(f"[PIPE DEBUG] properties         : {ep.get('properties')}")
                    print(f"[PIPE DEBUG] rotation           : {ep.get('rotation')}")
                    print(f"[PIPE DEBUG] position           : {ep.get('position')}")
                    # Derived info
                    try:
                        dm = self.start_port_item.parent_component.data_manager
                        model = dm.diagram_model
                        print(f"[PIPE DEBUG] components_count   : {len((model or {}).get('components', {}))}")
                        print(f"[PIPE DEBUG] pipes_count        : {len((model or {}).get('pipes', {}))}")
                    except Exception:
                        pass
                    print("[PIPE DEBUG] ===================================")
                except Exception as e:
                    print(f"[PIPE DEBUG] Error while dumping pipe info: {e}")
            else:  # Deselected
                # Restore original pen
                self.setPen(self._original_pen)
        return super().itemChange(change, value)
    
    # ------------------------------------------------------------------
    #  Segment dragging (CAD-style): grab any segment and slide it along
    #  its normal; neighbors stretch to keep orthogonality and the route
    #  stays pinned to the ports.
    # ------------------------------------------------------------------

    def _segment_at(self, scene_pos, max_dist=8.0):
        """Index of the route segment nearest to scene_pos, or None."""
        pts = self.pipe_data.get('route') or []
        best, best_d = None, max_dist
        for i in range(len(pts) - 1):
            a, b = pts[i], pts[i + 1]
            if abs(a[0] - b[0]) < self.EPS:   # vertical segment
                if min(a[1], b[1]) - 4 <= scene_pos.y() <= max(a[1], b[1]) + 4:
                    d = abs(scene_pos.x() - a[0])
                    if d < best_d:
                        best, best_d = i, d
            else:                              # horizontal segment
                if min(a[0], b[0]) - 4 <= scene_pos.x() <= max(a[0], b[0]) + 4:
                    d = abs(scene_pos.y() - a[1])
                    if d < best_d:
                        best, best_d = i, d
        return best

    def hoverMoveEvent(self, event):
        """Slide cursor matched to the segment under the mouse."""
        idx = self._segment_at(event.scenePos())
        if idx is not None:
            pts = self.pipe_data.get('route') or []
            vertical = abs(pts[idx][0] - pts[idx + 1][0]) < self.EPS
            self.setCursor(Qt.CursorShape.SizeHorCursor if vertical
                           else Qt.CursorShape.SizeVerCursor)
        else:
            self.setCursor(Qt.CursorShape.OpenHandCursor)
        super().hoverMoveEvent(event)

    def straighten_waypoints(self):
        """Flatten short jogs (< JOG_THRESHOLD px) in the route.

        A jog is a short segment between two parallel runs.  It is removed
        by shifting the neighboring run level with the other side; the
        offset is absorbed at the next bend.  Port-pinned vertices are
        grounded and never move, so the pipe always still reaches its ports.
        """
        pts = self._current_route()
        for _ in range(50):  # safety bound
            pts = self._sanitize_route(pts)
            applied = False
            for i in range(len(pts) - 1):
                a, b = pts[i], pts[i + 1]
                if abs(a[0] - b[0]) + abs(a[1] - b[1]) >= self.JOG_THRESHOLD:
                    continue
                axis = 1 if abs(a[0] - b[0]) < self.EPS else 0
                if i + 2 <= len(pts) - 2:
                    # Shift the run after the jog level with the run before
                    pts[i + 1][axis] = a[axis]
                    pts[i + 2][axis] = a[axis]
                    applied = True
                elif i - 1 >= 1:
                    # Next run is pinned to a port — shift the run before
                    pts[i][axis] = b[axis]
                    pts[i - 1][axis] = b[axis]
                    applied = True
                if applied:
                    break
            if not applied:
                break
        self.pipe_data['route'] = self._sanitize_route(pts)
        self.update_path()
        print(f"[STRAIGHTEN] {self.pipe_id}: {len(self.pipe_data['route'])} vertices")

    def mousePressEvent(self, event):
        """Remember which segment was grabbed; dragging starts on first move."""
        if event.button() == Qt.MouseButton.LeftButton:
            self._press_scene_pos = event.scenePos()
            self._drag_seg = self._segment_at(event.scenePos())
        super().mousePressEvent(event)

    def _begin_segment_drag(self):
        """Make the grabbed segment slidable.  Segments touching a port
        can't slide directly, so the port vertex is duplicated — the
        duplicate becomes a new corner and the port stays pinned."""
        pts = self.pipe_data['route']
        i = self._drag_seg
        self._drag_vertical = abs(pts[i][0] - pts[i + 1][0]) < self.EPS
        if i == 0:
            pts.insert(1, list(pts[0]))
            i += 1
        if i + 1 == len(pts) - 1:
            pts.insert(len(pts) - 1, list(pts[-1]))
        self._drag_seg = i
        self._is_dragging = True
        self.setCursor(Qt.CursorShape.ClosedHandCursor)
        print(f"[PIPE DRAG] Sliding segment {i} ({'vertical' if self._drag_vertical else 'horizontal'})")

    def mouseMoveEvent(self, event):
        """Slide the grabbed segment along its normal."""
        if (self._drag_seg is not None and not self._is_dragging
                and self._press_scene_pos is not None
                and (event.scenePos() - self._press_scene_pos).manhattanLength() > 4):
            self._begin_segment_drag()
        if self._is_dragging and self._drag_seg is not None:
            pts = self.pipe_data['route']
            i = self._drag_seg
            pos = snap_to_grid(event.scenePos())
            if self._drag_vertical:
                pts[i][0] = pts[i + 1][0] = pos.x()
            else:
                pts[i][1] = pts[i + 1][1] = pos.y()
            # Redraw without normalizing so segment indices stay stable
            self._set_path_from(pts)
            event.accept()
            return
        super().mouseMoveEvent(event)

    def mouseReleaseEvent(self, event):
        """Finish a segment drag and normalize the route."""
        if self._is_dragging and event.button() == Qt.MouseButton.LeftButton:
            self._is_dragging = False
            self._drag_seg = None
            self._press_scene_pos = None
            self.setCursor(Qt.CursorShape.OpenHandCursor)
            self.update_path()  # merge collinear / drop zero-length segments
            event.accept()
            return
        self._drag_seg = None
        self._press_scene_pos = None
        super().mouseReleaseEvent(event)


class SplitterComponentItem(BaseComponentItem):
    """1→N manifold glyph: single inlet top-center, N outlets across bottom.

    Geometry (in item coordinates, rect = [0,0,width,height]):
      inlet port  : (width/2, 0)           — top centre
      crossbar    : y = height/2            — horizontal bar spanning manifold_width
      stubs       : (px_i, height/2) → (px_i, height)
      outlet ports: (px_i, height)          — bottom, evenly distributed
    """

    def _manifold_data(self):
        n = self.component_data.get('properties', {}).get('circuits', 3)
        w = self.rect().width()
        h = self.rect().height()
        mw = max(w, n * 30)
        sx = (w - mw) / 2
        if n == 1:
            positions = [w / 2]
        else:
            sp = mw / (n - 1)
            positions = [sx + i * sp for i in range(n)]
        return w, h, positions, mw, sx

    def __init__(self, component_id, component_data, data_manager):
        super().__init__(component_id, component_data, data_manager)
        self.setBrush(QBrush(Qt.GlobalColor.transparent))
        self.setPen(QPen(Qt.GlobalColor.transparent))
        self.label.setVisible(False)
        self._manifold_item = None
        self._redraw_manifold()

    def _redraw_manifold(self):
        if self._manifold_item and self._manifold_item.scene():
            self._manifold_item.setParentItem(None)
        w, h, positions, mw, sx = self._manifold_data()
        xbar_y = h / 2
        path = QPainterPath()
        path.moveTo(w / 2, 0)
        path.lineTo(w / 2, xbar_y)
        if len(positions) > 1:
            path.moveTo(positions[0], xbar_y)
            path.lineTo(positions[-1], xbar_y)
        for px in positions:
            path.moveTo(px, xbar_y)
            path.lineTo(px, h)
        self._manifold_item = QGraphicsPathItem(path, self)
        self._manifold_item.setPen(QPen(QColor('#4DA6FF'), 2))

    def rebuild_ports(self):
        for port_item in list(self.ports.values()):
            port_item.setParentItem(None)
            if port_item.scene():
                port_item.scene().removeItem(port_item)
        self.ports.clear()

        w, h, positions, _mw, _sx = self._manifold_data()

        inlet_def = {'name': 'inlet', 'type': 'in', 'fluid_state': 'any',
                     'pressure_side': 'any', 'position': [0.5, 0]}
        p = PortItem('inlet', inlet_def, self)
        p.setPos(w / 2, 0)
        self.ports['inlet'] = p

        for i, px in enumerate(positions):
            name = f'outlet_{i + 1}'
            pdef = {'name': name, 'type': 'out', 'fluid_state': 'any',
                    'pressure_side': 'any', 'position': [px / max(w, 1), 1]}
            p = PortItem(name, pdef, self)
            p.setPos(px, h)
            self.ports[name] = p

    def update_connected_pipes(self):
        for port_item in self.ports.values():
            for pipe_item in port_item.connected_pipes:
                pipe_item.update_path()


class CombinerComponentItem(BaseComponentItem):
    """N→1 manifold glyph: N inlets across top, single outlet bottom-center.

    Geometry (in item coordinates, rect = [0,0,width,height]):
      inlet ports : (px_i, 0)              — top, evenly distributed
      stubs       : (px_i, 0) → (px_i, height/2)
      crossbar    : y = height/2            — horizontal bar spanning manifold_width
      outlet port : (width/2, height)       — bottom centre
    """

    def _manifold_data(self):
        n = self.component_data.get('properties', {}).get('circuits', 3)
        w = self.rect().width()
        h = self.rect().height()
        mw = max(w, n * 30)
        sx = (w - mw) / 2
        if n == 1:
            positions = [w / 2]
        else:
            sp = mw / (n - 1)
            positions = [sx + i * sp for i in range(n)]
        return w, h, positions, mw, sx

    def __init__(self, component_id, component_data, data_manager):
        super().__init__(component_id, component_data, data_manager)
        self.setBrush(QBrush(Qt.GlobalColor.transparent))
        self.setPen(QPen(Qt.GlobalColor.transparent))
        self.label.setVisible(False)
        self._manifold_item = None
        self._redraw_manifold()

    def _redraw_manifold(self):
        if self._manifold_item and self._manifold_item.scene():
            self._manifold_item.setParentItem(None)
        w, h, positions, mw, sx = self._manifold_data()
        xbar_y = h / 2
        path = QPainterPath()
        for px in positions:
            path.moveTo(px, 0)
            path.lineTo(px, xbar_y)
        if len(positions) > 1:
            path.moveTo(positions[0], xbar_y)
            path.lineTo(positions[-1], xbar_y)
        path.moveTo(w / 2, xbar_y)
        path.lineTo(w / 2, h)
        self._manifold_item = QGraphicsPathItem(path, self)
        self._manifold_item.setPen(QPen(QColor('#4DA6FF'), 2))

    def rebuild_ports(self):
        for port_item in list(self.ports.values()):
            port_item.setParentItem(None)
            if port_item.scene():
                port_item.scene().removeItem(port_item)
        self.ports.clear()

        w, h, positions, _mw, _sx = self._manifold_data()

        for i, px in enumerate(positions):
            name = f'inlet_{i + 1}'
            pdef = {'name': name, 'type': 'in', 'fluid_state': 'any',
                    'pressure_side': 'any', 'position': [px / max(w, 1), 0]}
            p = PortItem(name, pdef, self)
            p.setPos(px, 0)
            self.ports[name] = p

        outlet_def = {'name': 'outlet', 'type': 'out', 'fluid_state': 'any',
                      'pressure_side': 'any', 'position': [0.5, 1]}
        p = PortItem('outlet', outlet_def, self)
        p.setPos(w / 2, h)
        self.ports['outlet'] = p

    def update_connected_pipes(self):
        for port_item in self.ports.values():
            for pipe_item in port_item.connected_pipes:
                pipe_item.update_path()



